+            userMainLanguagePromptValue: "English",
+            userOtherLanguagesPromptValue: "",
+            dictionaryGlossary: nil,
+            appEnhancementEnabled: false,
+            appendsLanguagePreservationRules: appendsLanguagePreservationRules,
