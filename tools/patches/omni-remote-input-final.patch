diff --git a/Voxt/Voxt/App/RemoteInputFlow.swift b/Voxt/Voxt/App/RemoteInputFlow.swift
new file mode 100644
index 0000000..6d1c13c
--- /dev/null
+++ b/Voxt/Voxt/App/RemoteInputFlow.swift
@@ -0,0 +1,396 @@
+// RemoteInputFlow.swift
+// Provides Remote Input: dictations recorded on another device (Voxt Mobile) and sent here
+// over a tunnel run through the user's selected ASR model, enhancement and dictionary.
+// The result is returned to the device and saved to history; nothing is pasted on the Mac.
+
+import AppKit
+import Foundation
+
+extension AppDelegate {
+    static let remoteInputSourceName = "Voxt Mobile"
+
+    /// Starts or stops the server so it matches the stored settings.
+    func applyRemoteInputServerLifecycle() {
+        let shouldRun = RemoteInputSettings.isEnabled()
+        let port = RemoteInputSettings.port()
+        if !shouldRun || remoteInputServerPort != port {
+            stopRemoteInputServer()
+            remoteInputServerStatus = shouldRun ? .starting : .off
+        }
+        guard shouldRun, remoteInputServer == nil else { return }
+        // A napping menu bar app answers the phone tens of seconds late; stay awake while
+        // listening, but let the Mac itself sleep.
+        remoteInputActivity = ProcessInfo.processInfo.beginActivity(
+            options: .userInitiatedAllowingIdleSystemSleep,
+            reason: "Voxt Remote Input is waiting for dictations"
+        )
+
+        let pipeline = makeRemoteInputPipeline()
+        let router = RemoteInputRouter(token: RemoteInputSettings.token(), maxBodyBytes: RemoteInputSettings.maxBodyBytes)
+        let version = Bundle.main.object(forInfoDictionaryKey: "CFBundleShortVersionString") as? String ?? ""
+        let handler = RemoteInputRequestHandler.make(
+            router: router,
+            version: version,
+            dictate: { dictation in
+                await pipeline.run(dictation)
+            },
+            compose: { composeRequest in
+                await pipeline.runCompose(composeRequest)
+            },
+            correct: { correction in
+                await pipeline.runCorrection(correction)
+            },
+            capabilities: { [weak self] in
+                guard let self else { return .init(transcription: "unknown", text: "unknown") }
+                let speech = ASRHintSettingsStore.resolvedSettings(
+                    for: .dictation, rawValue: UserDefaults.standard.string(forKey: AppPreferenceKey.asrHintSettings))
+                return .resolve(transcriptionEngine: self.transcriptionEngine.rawValue,
+                                enhancementMode: self.enhancementMode.rawValue,
+                                appleSpeechOnDevice: speech.prefersOnDeviceRecognition)
+            },
+            sync: { request in
+                HistorySyncService(
+                    repository: HistoryRepository(),
+                    syncEnabled: RemoteInputSettings.isHistorySyncEnabled(),
+                    historyEnabled: RemoteInputSettings.isHistoryRecordingEnabled()
+                ).httpResponse(for: request)
+            }
+        )
+        let server = RemoteInputServer(port: UInt16(port), maxBodyBytes: RemoteInputSettings.maxBodyBytes, handler: handler)
+        remoteInputServer = server
+        remoteInputServerPort = port
+        remoteInputServerStatus = .starting
+        Task { @MainActor [weak self] in
+            do {
+                let bound = try await server.start()
+                VoxtLog.info("Remote input server listening on 127.0.0.1:\(bound)")
+                guard let self, self.remoteInputServer === server else { return }
+                self.remoteInputServerStatus = .listening(port: Int(bound))
+                self.warmUpRemoteInputModels()
+                self.startConnectorLink(port: Int(bound))
+            } catch {
+                VoxtLog.warning("Remote input server failed to start: \(error.localizedDescription)")
+                guard let self, self.remoteInputServer === server else { return }
+                self.remoteInputServer = nil
+                self.remoteInputServerPort = nil
+                self.remoteInputServerStatus = .failed(error.localizedDescription)
+            }
+        }
+    }
+
+    func stopRemoteInputServer() {
+        remoteInputWarmUp?.cancel()
+        remoteInputWarmUp = nil
+        connectorLinkServer?.stop()
+        connectorLinkServer = nil
+        remoteInputServer?.stop()
+        remoteInputServer = nil
+        remoteInputServerPort = nil
+        if let remoteInputActivity {
+            ProcessInfo.processInfo.endActivity(remoteInputActivity)
+            self.remoteInputActivity = nil
+        }
+    }
+
+    /// Lets the signed Voxt Connector fetch the port and Access token after one "Allow"
+    /// Manual entry in the Connector still works.
+    private func startConnectorLink(port: Int) {
+        connectorLinkServer?.stop()
+        connectorLinkServer = nil
+        // Ad-hoc and unsigned builds can't prove their identity; the Connector then uses manual entry.
+        guard let team = ConnectorLinkServer.ownTeamIdentifier() else {
+            VoxtLog.info("Connector link not started: this Voxt build has no signing team.")
+            return
+        }
+        let rememberedKey = "RemoteInputConnectorAlwaysAllowed"
+        let server = ConnectorLinkServer(
+            team: team,
+            isRemembered: { UserDefaults.standard.bool(forKey: rememberedKey) },
+            remember: { UserDefaults.standard.set(true, forKey: rememberedKey) },
+            ask: { await Self.askToAllowConnector() },
+            // Called off the main thread: the port is fixed while this listener runs.
+            credentials: { (port, RemoteInputSettings.token()) }
+        )
+        do {
+            try server.start()
+            connectorLinkServer = server
+        } catch {
+            VoxtLog.warning("Connector link did not start: \(error.localizedDescription)")
+        }
+    }
+
+    @MainActor
+    private static func askToAllowConnector() async -> ConnectorLinkServer.Decision {
+        NSApp.activate(ignoringOtherApps: true)
+        let alert = NSAlert()
+        alert.messageText = AppLocalization.localizedString("Allow Voxt Connector to use Voxt?")
+        alert.informativeText = AppLocalization.localizedString("It will forward dictations from your paired iPhone to Voxt on this Mac.")
+        alert.addButton(withTitle: AppLocalization.localizedString("Always Allow"))
+        alert.addButton(withTitle: AppLocalization.localizedString("Allow Once"))
+        alert.addButton(withTitle: AppLocalization.localizedString("Don't Allow"))
+        switch alert.runModal() {
+        case .alertFirstButtonReturn: return .allowAlways
+        case .alertSecondButtonReturn: return .allowOnce
+        default: return .deny
+        }
+    }
+
+    /// One silent transcription and one tiny generation when the server starts listening,
+    /// so the phone's first dictation does not wait for them to load (about 19 s cold).
+    private func warmUpRemoteInputModels() {
+        var speechReady = false
+        if transcriptionEngine == .mlxAudio {
+            let context = currentLocalASRStartContext()
+            let decision = RecordingStartPlanner.resolve(
+                selectedEngine: .mlxAudio,
+                selectedMLXRepo: context.selectedMLXRepo,
+                activeMLXDownloadRepo: context.activeMLXDownloadRepo,
+                isSelectedMLXModelDownloaded: context.isSelectedMLXModelDownloaded,
+                mlxModelState: context.mlxModelState
+            )
+            if case .blocked = decision {} else { speechReady = true }
+        }
+        let steps = RemoteInputWarmUp.plan(speechIsLocalAndReady: speechReady, textModel: remoteInputTextModel())
+        guard !steps.isEmpty else { return }
+        remoteInputWarmUp?.cancel()
+        remoteInputWarmUp = Task { @MainActor [weak self] in
+            let results = await RemoteInputWarmUp.run(steps, speech: { [weak self] in
+                guard let self, !Task.isCancelled else { return }
+                let url = FileManager.default.temporaryDirectory.appendingPathComponent("voxt-warmup-\(UUID().uuidString).wav")
+                try RemoteInputWarmUp.silenceWAV(seconds: 1).write(to: url)
+                defer { try? FileManager.default.removeItem(at: url) }
+                _ = try await self.transcribeRemoteInputAudio(at: url, language: nil)
+            }, text: { [weak self] in
+                guard let self, !Task.isCancelled else { return }
+                _ = try await self.composeTextStrictly(
+                    "OK.", instruction: "Repeat the text. Text: \(EnhancementPromptResolver.rawTranscriptionTemplateVariable)")
+            })
+            VoxtLog.info("Remote input warm-up: " + results.map {
+                "\($0.step) \($0.milliseconds) ms \($0.succeeded ? "ok" : "failed")"
+            }.joined(separator: ", "))
+        }
+    }
+
+    private func makeRemoteInputPipeline() -> RemoteInputDictationPipeline {
+        let pipeline = RemoteInputDictationPipeline(
+            temporaryDirectory: FileManager.default.temporaryDirectory,
+            busyReason: { [weak self] in self?.remoteInputBusyReason() },
+            transcribe: { [weak self] url, language in
+                guard let self else { throw CancellationError() }
+                return try await self.transcribeRemoteInputAudio(at: url, language: language)
+            },
+            enhance: { [weak self] text in
+                guard let self else { return text }
+                return try await self.enhanceRemoteInputTranscript(text)
+            },
+            finalize: { [weak self] text in
+                self?.finalizeRemoteInputText(text) ?? RemoteInputFinalText(text: text)
+            },
+            record: { [weak self] outcome in
+                self?.recordRemoteInputHistory(outcome)
+            }
+        )
+        pipeline.composeHandler = { [weak self] text, options in
+            guard let self else { throw CancellationError() }
+            return try await self.composeRemoteInputTranscript(text, options: options)
+        }
+        pipeline.correctHandler = { [weak self] request, instruction in
+            guard let self else { throw CancellationError() }
+            if let reason = RemoteInputComposePrompt.unavailabilityReason(for: self.remoteInputTextModel()) {
+                throw RemoteInputError(message: AppLocalization.localizedString(reason))
+            }
+            return try await self.composeTextStrictly(request.original, instruction: instruction)
+        }
+        return pipeline
+    }
+
+    private func remoteInputBusyReason() -> String? {
+        if isSessionActive {
+            return AppLocalization.localizedString("Voxt is recording on the Mac. Try again in a moment.")
+        }
+        if meetingSessionCoordinator.isActive {
+            return AppLocalization.localizedString("Voxt is recording a meeting on the Mac.")
+        }
+        return nil
+    }
+
+    private func transcribeRemoteInputAudio(at url: URL, language: String?) async throws -> String {
+        prepareLegacySettingsForSession(outputMode: .transcription)
+        synchronizeRuntimeASRStateForSession(outputMode: .transcription)
+
+        let text: String
+        switch transcriptionEngine {
+        case .mlxAudio:
+            let context = currentLocalASRStartContext()
+            let decision = RecordingStartPlanner.resolve(
+                selectedEngine: .mlxAudio,
+                selectedMLXRepo: context.selectedMLXRepo,
+                activeMLXDownloadRepo: context.activeMLXDownloadRepo,
+                isSelectedMLXModelDownloaded: context.isSelectedMLXModelDownloaded,
+                mlxModelState: context.mlxModelState
+            )
+            if case let .blocked(reason) = decision {
+                throw RemoteInputError(message: reason.userMessage)
+            }
+            let transcriber = mlxTranscriber ?? MLXTranscriber(modelManager: mlxModelManager)
+            mlxTranscriber = transcriber
+            text = try await transcriber.transcribeAudioFile(url, languageSelection: .request(language))
+        case .remote:
+            text = try await remoteASRTranscriber.transcribeMeetingAudioFile(url, languageSelection: .request(language))
+        case .dictation:
+            throw RemoteInputError(message: AppLocalization.localizedString(
+                "Apple Speech can't transcribe recorded audio. Choose a local or remote model in Voxt Settings > Transcription."
+            ))
+        }
+
+        return RecordingSessionSupport.normalizedTranscriptionDisplayText(
+            text,
+            transcriptionEngine: transcriptionEngine,
+            remoteProvider: remoteASRSelectedProvider,
+            userMainLanguage: userMainLanguage
+        )
+    }
+
+    private func enhanceRemoteInputTranscript(_ text: String) async throws -> String {
+        switch enhancementMode {
+        case .off:
+            return text
+        case .customLLM:
+            guard let repo = resolvedTranscriptionEnhancementLocalRepo(),
+                  customLLMManager.canAttemptInference(repo: repo) else {
+                VoxtLog.asrWarning("Remote input: custom LLM selected but not installed. Returning raw transcription.")
+                return text
+            }
+        case .appleIntelligence, .remoteLLM:
+            break
+        }
+        // The Mac's frontmost app says nothing about where the phone will paste, so App Branch
+        // prompts are skipped and the global transcription prompt is used.
+        return try await enhanceTextForCurrentMode(text, sessionID: nil, usesAppBranch: false)
+    }
+
+    /// Translate, edit, write — and option-carrying dictations — reuse the selected Voxt
+    /// text model with a mode-specific prompt for this one request. Selected settings are
+    /// read, never changed. Unlike plain dictation this path fails closed: without a
+    /// working model it throws instead of returning raw speech as if the operation had
+    /// succeeded.
+    private func remoteInputTextModel() -> RemoteInputComposePrompt.TextModel {
+        switch enhancementMode {
+        case .off:
+            return .disabled
+        case .customLLM:
+            return .customLLM(ready: resolvedTranscriptionEnhancementLocalRepo().map { repo in
+                customLLMManager.canAttemptInference(repo: repo)
+            } ?? false)
+        case .remoteLLM:
+            let context = resolvedRemoteLLMContext(forTranslation: false)
+            return .remoteLLM(configured: RemoteModelConfigurationStore.isStoredLLMConfigurationConfigured(
+                provider: context.provider,
+                stored: remoteLLMConfigurations
+            ))
+        case .appleIntelligence:
+            return .appleIntelligence
+        }
+    }
+
+    private func composeRemoteInputTranscript(_ text: String, options: RemoteInputComposeOptions) async throws -> String {
+        if let reason = RemoteInputComposePrompt.unavailabilityReason(for: remoteInputTextModel()) {
+            throw RemoteInputError(message: AppLocalization.localizedString(reason))
+        }
+        return try await RemoteInputComposePrompt.compose(rawTranscription: text, options: options) { instruction in
+            try await self.composeTextStrictly(text, instruction: instruction)
+        }
+    }
+
+    private func finalizeRemoteInputText(_ text: String) -> RemoteInputFinalText {
+        let context = Self.preparedDeliveryContext(
+            originalText: text,
+            llmDurationSeconds: nil,
+            sessionOutputMode: .transcription,
+            userMainLanguage: userMainLanguage,
+            matcher: dictionaryStore.makeMatcherIfEnabled(for: text, activeGroupID: activeDictionaryGroupID()),
+            usesConservativeEvidence: false,
+            automaticReplacementEnabled: UserDefaults.standard.bool(
+                forKey: AppPreferenceKey.dictionaryHighConfidenceCorrectionEnabled
+            )
+        )
+        dictionaryStore.recordMatches(context.dictionaryMatches)
+        return RemoteInputFinalText(
+            text: context.outputText,
+            dictionaryHitTerms: Self.orderedUniqueDictionaryTerms(from: context.dictionaryMatches.map(\.term)),
+            dictionaryCorrectedTerms: Self.orderedUniqueDictionaryTerms(from: context.dictionaryCorrectedTerms)
+        )
+    }
+
+    private func recordRemoteInputHistory(_ outcome: RemoteInputDictationOutcome) {
+        guard historyEnabled else { return }
+        let textModel = outcome.usedEnhancement
+            ? resolvedHistoryTextModelMetadata(for: .normal)
+            : HistoryTextModelMetadata(
+                modeTitle: EnhancementMode.off.title,
+                modelTitle: "None",
+                remoteProviderTitle: nil,
+                remoteModelTitle: nil,
+                remoteEndpoint: nil
+            )
+
+        let transcriptionModel: String
+        var remoteASRProvider: String?
+        var remoteASRModel: String?
+        switch transcriptionEngine {
+        case .dictation:
+            transcriptionModel = "Apple Speech Recognition"
+        case .mlxAudio:
+            let repo = mlxModelManager.currentModelRepo
+            transcriptionModel = "\(mlxModelManager.displayTitle(for: repo)) (\(repo))"
+        case .remote:
+            let provider = remoteASRSelectedProvider
+            let model = remoteASRConfigurations[provider.rawValue]?.model
+            transcriptionModel = model.map { "\(provider.title) (\($0))" } ?? provider.title
+            remoteASRProvider = provider.title
+            remoteASRModel = model
+        }
+
+        _ = historyStore.append(
+            entryID: outcome.id,
+            text: outcome.text,
+            transcriptionEngine: transcriptionEngine.title,
+            transcriptionModel: transcriptionModel,
+            enhancementMode: textModel.modeTitle,
+            enhancementModel: textModel.modelTitle,
+            kind: .normal,
+            isTranslation: false,
+            audioDurationSeconds: nil,
+            transcriptionProcessingDurationSeconds: outcome.transcriptionSeconds,
+            llmDurationSeconds: outcome.enhancementSeconds,
+            focusedAppName: Self.remoteInputSourceName,
+            focusedAppBundleID: nil,
+            matchedGroupID: nil,
+            matchedGroupName: nil,
+            matchedAppGroupName: nil,
+            matchedURLGroupName: nil,
+            remoteASRProvider: remoteASRProvider,
+            remoteASRModel: remoteASRModel,
+            remoteASREndpoint: nil,
+            remoteLLMProvider: textModel.remoteProviderTitle,
+            remoteLLMModel: textModel.remoteModelTitle,
+            remoteLLMEndpoint: textModel.remoteEndpoint,
+            whisperWordTimings: nil,
+            dictionaryHitTerms: outcome.dictionaryHitTerms,
+            dictionaryCorrectedTerms: outcome.dictionaryCorrectedTerms,
+            dictionarySuggestedTerms: []
+        )
+    }
+}
+
+enum RemoteInputServerStatus: Equatable {
+    case off
+    case starting
+    case listening(port: Int)
+    case failed(String)
+}
+
+struct RemoteInputError: LocalizedError {
+    var message: String
+    var errorDescription: String? { message }
+}
