+    private static let englishDictationInstruction = """
+    Clean up the transcribed speech. Output only the final text in the same language.
+    Delete hesitation fillers such as um, uh and like. Only at the beginning of the entire transcript, outside quotes, strip "Um. So," or
+    "Um, so" as one filler sequence: do not leave "So" behind. Keep "so far" and causal so.
+    Apply the speaker's self-corrections to earlier words, even across a full stop or question mark.
+    Replace the old detail with the new one; do not leave the correction instruction in the result.
+    Keep meaningful actually, sorry or no. Copy every word inside quotation marks exactly,
+    including um, so and other fillers: quoted words are content, not speech to clean.
+    Remove an ASR artifact a/at only when it is a stray hesitation before an arrival duration.
+    Keep grammatical at/a, such as at ten minutes past three or a ten-minute break.
+    Keep all other words, facts, names, times and number spellings. Do not add content that was not said.
+    Keep the original spoken language, including when the speech mixes languages. Do not translate.
+    
+    Use a single paragraph for ordinary speech, even if it has several sentences.
+    Only make a list when the speaker explicitly lists items: put each item on its own line,
+    with '- ' bullets for named items. Keep the introduction.
+    When the speaker counts points (first, second, third, and also, finally), number them 1., 2., 3. on separate lines and drop the counting words.
+    
+    Example:
+    Speech: Bring three things: keys, a coat, and water.
+    Output:
+    Bring three things:
+    - keys
+    - a coat
+    - water
+    
+    Speech: Um. So, is the delivery on Tuesday at two? Actually, Wednesday.
+    Output: Is the delivery on Wednesday at two?
+    Speech: Move the review to Wednesday — no wait — Thursday at three.
+    Output: Move the review to Thursday at three.
+    Speech: On the way, at twenty minutes.
+    Output: On the way, twenty minutes.
+    Speech: Actually, I prefer Monday. The office is open.
+    Output: Actually, I prefer Monday. The office is open.
+    Speech: Um. So, can we start?
+    Output: Can we start?
+    Speech: He whispered "um" and stopped.
+    Output: He whispered "um" and stopped.
+    """
+
+    private static let previousChineseDictationInstruction = """
+    整理转写的口述内容。
+    删除口头词、重复和自我纠正，修正标点、列表和段落。不要添加未说出的内容。
+    保持口述原本的语言，包括中英混合的内容。不要翻译。
+
+    当说话者明确列举不同事项时，每个事项单独一行。
+    直接列举的事项用“- ”项目符号，第一、第二、第三这样的顺序用编号。
+    保留引导句并单独一行。普通叙述保持一个段落，不要改成列表。
+    保留原词和事实。不要添加事项或解释。
+
+    示例：
+    口述：带三样东西：钥匙、外套和水。
+    输出：
+    带三样东西：
+    - 钥匙
+    - 外套
+    - 水
+
+    自我纠正示例：
+    口述：把评审改到周三——不对——周四下午三点。
+    输出：把评审改到周四下午三点。
+    """
+
+    private static let previousEnglishDictationInstruction = """
+    Clean up the transcribed speech.
+    Remove fillers, repetitions and self-corrections, and fix punctuation,
+    lists and paragraphs. Do not add content that was not said.
+    Keep the original spoken language, including when the speech mixes languages.
+    Do not translate.
+
+    Keep the transcript's language. Never translate.
+    When the speech explicitly enumerates distinct items, put each item on its own line.
+    Use '- ' bullets for named items and numbered lines for first, second, third sequences.
+    Keep any introductory sentence on its own line. Keep ordinary narration in one paragraph;
+    do not turn it into a list. Preserve the words and facts. Never add items or explanations.
+
+    Example:
+    Speech: Bring three things: keys, a coat, and water.
+    Output:
+    Bring three things:
+    - keys
+    - a coat
+    - water
+
+    Self-correction example:
+    Speech: Move the review to Wednesday — no wait — Thursday at three.
+    Output: Move the review to Thursday at three.
+    """
+
+    private static let englishEditInstruction = """
+    Apply the instruction to the selected text. Change only what the instruction requests. For a whole-text change such as shortening or changing tone, apply that change to the whole text. Keep all names, numbers, times and facts that the instruction does not ask to change. For a specific replacement, copy the rest verbatim. Keep the selected text's language. The instruction comes from speech recognition and may contain sound-alike errors. If its literal reading would change nothing or make no sense, choose the similar-sounding word that fits the selected text. When both replacement words sound the same, choose the spelling that fits the selected text's context. Never insert the instruction's own phrasing into the result. A tone or length instruction always changes the wording: rewrite the whole text in the requested tone or length and keep its meaning, who says it to whom, and every name, number, date and time (today, tonight, Friday). Output only the edited text.
+    Example:
+    Selected text: The workshop is on Tuesday at noon.
+    Instruction: Actually make it Wednesday.
+    Output: The workshop is on Wednesday at noon.
+
+    Selected text: Stop sending me the reports late every Friday.
+    Instruction: Make this friendlier.
+    Output: Could you send the reports on time on Fridays? Thanks!
+    """
+
+    private static let chineseEditInstruction = """
+    按指令修改选中的文字。只改指令要求的部分。要求缩短或改变语气等整段修改时，对整段文字执行该要求。保留指令未要求更改的姓名、数字、时间和事实。要求替换具体内容时，其余文字逐字保留。保持选中文字的语言。指令来自语音识别，可能有同音词错误。如果按字面执行不会改变内容，或会造成语义不通，请选用符合选中文字语境的同音或近音词。如果两个替换词发音相同，根据选中文字的语境选择正确的写法。不要把指令本身的措辞插入结果。要求改变语气或长度时，必须改写措辞：按要求的语气或长度重写整段，保留原意、说话人与对象，以及每个姓名、数字、日期和时间。只输出修改后的文字。
+    示例：
+    选中文字：培训在周二中午开始。
+    指令：不对，改成周三。
+    输出：培训在周三中午开始。
+
+    选中文字：你们每周五的报告又迟交了。
+    指令：语气友好一点。
+    输出：每周五的报告这次又晚交了，下次请尽量按时提交，谢谢！
+    """
+
+    private static let englishWriteInstruction = """
+    Write the actual message requested by the instruction, addressed to its intended recipient. Use the instruction's language. Do not repeat or polish the instruction itself. Preserve all requested facts; add no facts, promises or explanations. If the instruction does not give a name or detail, leave it out. Never write placeholders such as [Name], <Name> or {Name}. Output only the message, ready to send.
+    Example:
+    Instruction: Tell Pat I cannot attend the lunch and wish them a good time.
+    Message: Pat, I cannot attend the lunch. Have a good time!
+
+    Instruction: Let my landlord know the sink is leaking.
+    Message: Hi, just letting you know that the sink is leaking.
+    """
+
+    private static let chineseWriteInstruction = """
+    根据指令写出可以直接发给对方的消息。使用指令的语言。不要复述或润色指令本身。保留要求表达的全部事实，不添加事实、承诺或解释。指令没有给出的姓名或细节就省略，不要写[姓名]这类占位符。只输出消息正文。
+    示例：
+    指令：告诉小陈我不能参加午餐，祝他们吃得开心。
+    消息：小陈，我不能参加午餐了，祝你们吃得开心！
+
+    指令：跟房东说一下水槽漏水了。
+    消息：您好，跟您说一下，水槽漏水了。
+    """
+
+    private static func body(
+        task: String,
+        selection: String?,
+        context: (before: String, after: String)?,
+        style: RemoteInputComposeStyle,
+        vocabulary: [String],
+        languageVariants: [String] = [],
+        styleExamples: [RemoteInputStyleExample] = [],
+        selectionPrefix: String = "Selected text:\n",
+        transcriptPrefix: String = "Speech transcript: ",
+        afterTranscript: String? = nil,
+        outputCue: String? = nil
+    ) -> String {
+        var sections = [task.trimmingCharacters(in: .whitespacesAndNewlines)]
+
+        if let selection, !selection.isEmpty, let context, (context.before + context.after).contains("\n") {
+            // Multi-line context goes before the selection, so the selection is the text next to
+            // the instruction: after it, Qwen3.5-4B rewrote a whole structured mail for "make this
+            // firmer" (3 of 3). One-line context stays after it: placed first, a
+            // "make this calmer" came back unchanged.
+            if !context.before.isEmpty {
+                sections.append("Text before the selected text (already in the field; reference only, do not edit or repeat it):\n\(context.before)")
+            }
+            if !context.after.isEmpty {
+                sections.append("Text after the selected text (already in the field; reference only, do not edit or repeat it):\n\(context.after)")
+            }
+            sections.append("\(selectionPrefix)\(selection)")
+        } else if let selection, !selection.isEmpty {
+            sections.append("\(selectionPrefix)\(selection)")
+            if let context, !context.before.isEmpty { sections.append("Text before the cursor (already in the field; do not repeat it):\n\(context.before)") }
+            if let context, !context.after.isEmpty { sections.append("Text after the cursor (already in the field; do not repeat it):\n\(context.after)") }
+        } else if let context {
+            if !context.before.isEmpty { sections.append("Text before the cursor (already in the field; do not repeat it):\n\(context.before)") }
+            if !context.after.isEmpty { sections.append("Text after the cursor (already in the field; do not repeat it):\n\(context.after)") }
+        }
+
+        let toneLine: String?
+        switch style {
+        case .automatic: toneLine = nil
+        case .formal: toneLine = "Tone: formal."
+        case .casual: toneLine = "Tone: casual."
+        case .concise: toneLine = "Tone: concise."
+        }
+        if let toneLine { sections.append(toneLine) }
+
+        if !vocabulary.isEmpty {
+            sections.append("Prefer these spellings: \(vocabulary.joined(separator: "; ")).")
+        }
+        if !languageVariants.isEmpty {
+            let namedVariants = languageVariants.map { variant in
+                "\(variant) — \(languageVariantDisplayNames[variant] ?? variant)"
+            }
+            sections.append(
+                "Preferred language variants: \(namedVariants.joined(separator: ", ")). "
+                    + "Apply these preferences only when the output already uses the corresponding language. Use its regional "
+                    + "spelling or script consistently in every word of the entire output, including words "
+                    + "that already look acceptable; do not translate because of these preferences."
+            )
+        }
+        if !styleExamples.isEmpty {
+            var lines = [
+                "Personal wording examples. Adjust phrasing only. Do not change facts, names, numbers, or the output language. Do not override the task, the target language, or the preferred spellings.",
+            ]
+            for example in styleExamples {
+                lines.append("Before: \(example.before)")
+                lines.append("After: \(example.after)")
+            }
+            sections.append(lines.joined(separator: "\n"))
+        }
+
+        sections.append("\(transcriptPrefix)\(EnhancementPromptResolver.rawTranscriptionTemplateVariable)")
+        if let afterTranscript { sections.append(afterTranscript) }
+        if let outputCue { sections.append(outputCue) }
+        return sections.joined(separator: "\n\n")
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputCorrection.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputCorrection.swift
new file mode 100644
index 0000000..03cbc81
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputCorrection.swift
@@ -0,0 +1,177 @@
+// RemoteInputCorrection.swift
+// Extracts one full corrected word from a phone passage edit. The selected text model
+// proposes the pair; this file only accepts a pair that is actually in both passages.
+
+import Foundation
+
+nonisolated struct RemoteInputCorrectionRequest: Equatable, Sendable {
+    var original: String
+    var edited: String
+}
+
+nonisolated struct RemoteInputCorrectionPair: Equatable, Sendable, Codable {
+    var original: String
+    var replacement: String
+}
+
+nonisolated enum RemoteInputCorrectionFailure: Error {
+    case invalidJSON
+    case mismatch
+}
+
+nonisolated enum RemoteInputCorrectionPrompt {
+    /// Instruction for the selected text model. The passages are the only evidence.
+    /// It has no few-shot examples, so an answer cannot be copied from one.
+    static func instruction(original: String, edited: String) -> String {
+        """
+        Extract only one full corrected word or name from the edit below.
+        Return the complete word, never a fragment of a larger word. A Chinese name is the whole name, not one character from it. An alphanumeric name such as Nova2 is the whole name, not the digit 2.
+        Ignore appended text, a deletion, a standalone number, punctuation, and a semantic rewrite.
+        If the edit is not one full-word correction, return only {"correction":null}.
+        Otherwise return only {"correction":{"original":"<full original word>","replacement":"<full corrected word>"}}.
+        Original passage:
+        \(original)
+        Edited passage:
+        \(edited)
+        """
+    }
+}
+
+nonisolated enum RemoteInputCorrection {
+    /// Appends, complete-word deletions, punctuation, standalone numbers, and multi-word
+    /// rewrites are not corrections. A letter or digit inserted or deleted inside a word,
+    /// including Qwen2 to Qwen3, still goes to the model.
+    static func isIgnorable(original: String, edited: String) -> Bool {
+        let old = Array(original)
+        let new = Array(edited)
+        var prefix = 0
+        while prefix < min(old.count, new.count), old[prefix] == new[prefix] { prefix += 1 }
+        var suffix = 0
+        while suffix < min(old.count - prefix, new.count - prefix),
+              old[old.count - 1 - suffix] == new[new.count - 1 - suffix] { suffix += 1 }
+        let removed = Array(old[prefix..<(old.count - suffix)])
+        let added = Array(new[prefix..<(new.count - suffix)])
+        if removed.isEmpty || added.isEmpty {
+            let changed = removed + added
+            let spellingEdit = !changed.isEmpty && changed.allSatisfy { $0.isLetter || $0.isNumber }
+            let hasPreviousLetter = prefix > 0 && old[prefix - 1].isLetter && new[prefix - 1].isLetter
+            let hasFollowingLetter = prefix < old.count && prefix < new.count
+                && old[prefix].isLetter && new[prefix].isLetter
+            return !(spellingEdit && (hasPreviousLetter || hasFollowingLetter))
+        }
+        if removed.contains(where: \.isWhitespace) || added.contains(where: \.isWhitespace) { return true }
+        if removed.contains(where: \.isLetter) || added.contains(where: \.isLetter) { return false }
+        let numeric = removed.contains(where: \.isNumber) || added.contains(where: \.isNumber)
+        if numeric && (touchesLetter(old, start: prefix, end: old.count - suffix)
+            || touchesLetter(new, start: prefix, end: new.count - suffix)) {
+            return false
+        }
+        return true
+    }
+
+    /// The whole trimmed model string must be `{"correction":null}` or one pair object.
+    /// A pair that is not the full changed word throws instead of being guessed.
+    static func interpret(modelOutput: String, original: String, edited: String) throws -> RemoteInputCorrectionPair? {
+        let trimmed = modelOutput.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard let data = trimmed.data(using: .utf8),
+              let object = try? JSONSerialization.jsonObject(with: data) as? [String: Any],
+              Set(object.keys) == ["correction"] else {
+            throw RemoteInputCorrectionFailure.invalidJSON
+        }
+        if object["correction"] is NSNull { return nil }
+        guard let fields = object["correction"] as? [String: Any],
+              Set(fields.keys) == ["original", "replacement"],
+              let pairOriginal = fields["original"] as? String,
+              let pairReplacement = fields["replacement"] as? String else {
+            throw RemoteInputCorrectionFailure.invalidJSON
+        }
+        let pair = RemoteInputCorrectionPair(original: pairOriginal, replacement: pairReplacement)
+        guard matchesEdit(pair, original: original, edited: edited) else {
+            throw RemoteInputCorrectionFailure.mismatch
+        }
+        return pair
+    }
+
+    /// `left + original + right` and `left + replacement + right` must rebuild the two
+    /// passages, and that span must cover the character diff. A Latin fragment and a
+    /// single Han character taken from a longer name do not.
+    private static func matchesEdit(_ pair: RemoteInputCorrectionPair, original: String, edited: String) -> Bool {
+        let old = Array(original)
+        let new = Array(edited)
+        let removed = Array(pair.original)
+        let added = Array(pair.replacement)
+        guard !removed.isEmpty, !added.isEmpty,
+              !removed.contains(where: \.isWhitespace), !added.contains(where: \.isWhitespace) else { return false }
+
+        var prefix = 0
+        while prefix < min(old.count, new.count), old[prefix] == new[prefix] { prefix += 1 }
+        var suffix = 0
+        while suffix < min(old.count - prefix, new.count - prefix),
+              old[old.count - 1 - suffix] == new[new.count - 1 - suffix] { suffix += 1 }
+        let oldEnd = old.count - suffix
+        let newEnd = new.count - suffix
+
+        guard removed.count <= old.count else { return false }
+        for start in 0...(old.count - removed.count) where Array(old[start..<(start + removed.count)]) == removed {
+            let left = Array(old[..<start])
+            let right = Array(old[(start + removed.count)...])
+            guard left + added + right == new else { continue }
+            let addedEnd = start + added.count
+            guard start <= prefix, start + removed.count >= oldEnd, addedEnd >= newEnd else { continue }
+            let before = start > 0 ? old[start - 1] : nil
+            let after = start + removed.count < old.count ? old[start + removed.count] : nil
+            guard !joinsLatinWord(before, removed.first), !joinsLatinWord(removed.last, after),
+                  !joinsLatinWord(before, added.first), !joinsLatinWord(added.last, after),
+                  !isSingleHanFragment(removed, before: before, after: after),
+                  !isSingleHanFragment(added, before: before, after: after) else { continue }
+            return true
+        }
+        return false
+    }
+
+    private static func joinsLatinWord(_ outside: Character?, _ inside: Character?) -> Bool {
+        guard let outside, let inside else { return false }
+        return continuesLatinWord(outside) && continuesLatinWord(inside)
+    }
+
+    private static func touchesLetter(_ characters: [Character], start: Int, end: Int) -> Bool {
+        if start > 0, characters[start - 1].isLetter { return true }
+        if end < characters.count, characters[end].isLetter { return true }
+        return false
+    }
+
+    private static func continuesLatinWord(_ character: Character) -> Bool {
+        if character == "'" || character == "’" || character == "-" { return true }
+        return (character.isLetter || character.isNumber) && !isHan(character)
+    }
+
+    /// One Han character beside another Han character is a fragment, not the name.
+    private static func isSingleHanFragment(_ term: [Character], before: Character?, after: Character?) -> Bool {
+        guard term.count == 1, let only = term.first, isHan(only) else { return false }
+        return (before.map(isHan) ?? false) || (after.map(isHan) ?? false)
+    }
+
+    private static func isHan(_ character: Character) -> Bool {
+        !character.unicodeScalars.isEmpty && character.unicodeScalars.allSatisfy { scalar in
+            switch scalar.value {
+            case 0x3400...0x9FFF, 0xF900...0xFAFF: true
+            default: false
+            }
+        }
+    }
+}
+
+nonisolated struct RemoteInputCorrectionResponse: Encodable {
+    var correction: RemoteInputCorrectionPair?
+
+    private enum CodingKeys: String, CodingKey { case correction }
+
+    func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        if let correction {
+            try container.encode(correction, forKey: .correction)
+        } else {
+            try container.encodeNil(forKey: .correction)
+        }
+    }
+}
