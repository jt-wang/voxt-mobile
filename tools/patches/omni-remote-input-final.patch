+            RemoteInputComposeMode.dictate.rawValue: englishDictationInstruction,
+            RemoteInputComposeMode.edit.rawValue: englishEditInstruction,
+            RemoteInputComposeMode.translate.rawValue: translateTask(target: targetLanguageTemplateVariable),
