+// RemoteInputWarmUpTests.swift
+// Without warm-up, the first phone request after the host starts pays for loading the speech
+// runtime (about 19 s). Warm-up moves that cost to launch, for local models only.
+
+import XCTest
+@testable import Voxt
+
+final class RemoteInputWarmUpTests: XCTestCase {
+    func testPlanWarmsOnlyLocalReadyModels() {
+        XCTAssertEqual(RemoteInputWarmUp.plan(speechIsLocalAndReady: true, textModel: .customLLM(ready: true)), [.speech, .text])
+        XCTAssertEqual(RemoteInputWarmUp.plan(speechIsLocalAndReady: false, textModel: .customLLM(ready: true)), [.text])
+        XCTAssertEqual(RemoteInputWarmUp.plan(speechIsLocalAndReady: true, textModel: .remoteLLM(configured: true)), [.speech],
+                       "never spend a cloud request on warm-up")
+        XCTAssertEqual(RemoteInputWarmUp.plan(speechIsLocalAndReady: true, textModel: .customLLM(ready: false)), [.speech])
+        XCTAssertEqual(RemoteInputWarmUp.plan(speechIsLocalAndReady: false, textModel: .disabled), [])
+    }
+
+    func testSilenceIsAOneSecondSixteenKilohertzMonoWAV() {
+        let wav = RemoteInputWarmUp.silenceWAV(seconds: 1)
+        XCTAssertEqual(wav.count, 44 + 32_000)
+        XCTAssertEqual(String(decoding: wav.prefix(4), as: UTF8.self), "RIFF")
+        XCTAssertEqual(String(decoding: wav[8..<12], as: UTF8.self), "WAVE")
+        XCTAssertTrue(wav.dropFirst(44).allSatisfy { $0 == 0 })
+    }
+
