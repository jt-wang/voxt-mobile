@@ -0,0 +1,91 @@
+// RemoteInputSettingsTests.swift
+// Provides Remote Input settings tests for Voxt test coverage.
+
+import XCTest
+@testable import Voxt
+
+final class RemoteInputSettingsTests: XCTestCase {
+    private func withEphemeralDefaults(_ body: (UserDefaults) throws -> Void) rethrows {
+        let suiteName = "RemoteInputSettingsTests.\(UUID().uuidString)"
+        guard let defaults = UserDefaults(suiteName: suiteName) else {
+            return XCTFail("Expected ephemeral UserDefaults suite")
+        }
+        defaults.removePersistentDomain(forName: suiteName)
+        defer { defaults.removePersistentDomain(forName: suiteName) }
+        try body(defaults)
+    }
+
+    func testDisabledAndDefaultPortWhenUnset() {
+        withEphemeralDefaults { defaults in
+            XCTAssertFalse(RemoteInputSettings.isEnabled(defaults: defaults))
+            XCTAssertEqual(RemoteInputSettings.port(defaults: defaults), RemoteInputSettings.defaultPort)
+        }
+    }
+
+    func testOutOfRangePortFallsBackToDefault() {
+        withEphemeralDefaults { defaults in
+            defaults.set(80, forKey: AppPreferenceKey.remoteInputServerPort)
+            XCTAssertEqual(RemoteInputSettings.port(defaults: defaults), RemoteInputSettings.defaultPort)
+            defaults.set(65535, forKey: AppPreferenceKey.remoteInputServerPort)
+            XCTAssertEqual(RemoteInputSettings.port(defaults: defaults), RemoteInputSettings.defaultPort)
+            defaults.set(52000, forKey: AppPreferenceKey.remoteInputServerPort)
+            XCTAssertEqual(RemoteInputSettings.port(defaults: defaults), 52000)
+        }
+    }
+
+    /// `tailscale serve` listens on the tailnet addresses at its HTTPS port, and macOS then
+    /// refuses 127.0.0.1 on that same port, so the phone-facing port must differ.
+    func testTailscaleServeUsesADifferentPublicPort() {
+        XCTAssertEqual(RemoteInputSettings.publicPort(forLocalPort: 47910), 47911)
+        XCTAssertEqual(
+            RemoteInputSettings.tailscaleServeCommand(port: 47910),
+            "tailscale serve --bg --https=47911 http://127.0.0.1:47910"
+        )
+    }
+
+    func testTokenIsStableAcrossReadsWhenKeychainWritesFail() {
+        VoxtSecureStorage.clearAllForTesting()
+        RemoteInputSettings.resetUnsavedTokenForTesting()
+        VoxtSecureStorage.setProtectedWritesFailForTesting(true)
+        defer {
+            VoxtSecureStorage.setProtectedWritesFailForTesting(false)
+            VoxtSecureStorage.clearAllForTesting()
+            RemoteInputSettings.resetUnsavedTokenForTesting()
+        }
+
+        let first = RemoteInputSettings.token(environment: [:])
+        XCTAssertEqual(RemoteInputSettings.token(environment: [:]), first)
+
+        let regenerated = RemoteInputSettings.regenerateToken()
+        XCTAssertNotEqual(regenerated, first)
+        XCTAssertEqual(RemoteInputSettings.token(environment: [:]), regenerated)
+    }
+
+    func testTokenIsSavedToSecureStorage() {
+        VoxtSecureStorage.clearAllForTesting()
+        RemoteInputSettings.resetUnsavedTokenForTesting()
+        defer { VoxtSecureStorage.clearAllForTesting() }
+
+        let token = RemoteInputSettings.token(environment: [:])
+        XCTAssertEqual(VoxtSecureStorage.string(for: RemoteInputSettings.tokenAccount), token)
+    }
+
+    func testDebugBuildsAcceptTokenFromEnvironment() {
+        XCTAssertEqual(
+            RemoteInputSettings.token(environment: ["VOXT_REMOTE_INPUT_TOKEN": "from-env"]),
+            "from-env"
+        )
+    }
+
+    func testPairingLinkEncodesAddressAndToken() throws {
+        let link = try XCTUnwrap(RemoteInputSettings.pairingLink(
+            baseURL: "https://mac.tail1.ts.net:47910",
+            token: "a-b_c"
+        ))
+        let components = try XCTUnwrap(URLComponents(url: link, resolvingAgainstBaseURL: false))
+        XCTAssertEqual(components.scheme, "voxtmobile")
+        XCTAssertEqual(components.host, "pair")
+        XCTAssertEqual(components.queryItems?.first { $0.name == "url" }?.value, "https://mac.tail1.ts.net:47910")
+        XCTAssertEqual(components.queryItems?.first { $0.name == "token" }?.value, "a-b_c")
+    }
+}
