--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputWarmUp.swift
@@ -0,0 +1,60 @@
+// RemoteInputWarmUp.swift
+// Loads the speech and text models once when Remote Input starts listening, so the
+// phone's first dictation does not pay the cold start (about 19 s).
+// Warm-up runs only for local models: it never spends a cloud request.
+
+import Foundation
+
+nonisolated enum RemoteInputWarmUp {
+    enum Step: Equatable, Sendable { case speech, text }
+
+    struct Result: Equatable, Sendable {
+        var step: Step
+        var milliseconds: Int
+        var succeeded: Bool
+    }
+
+    static func plan(speechIsLocalAndReady: Bool, textModel: RemoteInputComposePrompt.TextModel) -> [Step] {
+        var steps: [Step] = []
+        if speechIsLocalAndReady { steps.append(.speech) }
+        switch textModel {
+        case .customLLM(ready: true), .appleIntelligence: steps.append(.text)
+        case .customLLM(ready: false), .remoteLLM, .disabled: break
+        }
+        return steps
+    }
+
+    /// 16 kHz mono 16-bit PCM silence; one second is enough to load and compile the model.
+    static func silenceWAV(seconds: Double) -> Data {
+        let sampleRate = 16_000
+        let dataBytes = Int(Double(sampleRate) * seconds) * 2
+        var data = Data()
+        func append<T: FixedWidthInteger>(_ value: T) { withUnsafeBytes(of: value.littleEndian) { data.append(contentsOf: $0) } }
+        data.append(contentsOf: Array("RIFF".utf8)); append(UInt32(36 + dataBytes))
+        data.append(contentsOf: Array("WAVE".utf8)); data.append(contentsOf: Array("fmt ".utf8))
+        append(UInt32(16)); append(UInt16(1)); append(UInt16(1)); append(UInt32(sampleRate))
+        append(UInt32(sampleRate * 2)); append(UInt16(2)); append(UInt16(16))
+        data.append(contentsOf: Array("data".utf8)); append(UInt32(dataBytes))
+        data.append(Data(count: dataBytes))
+        return data
+    }
+
+    /// Runs each step in order; a failed step is logged by the caller and does not stop the next.
+    static func run(_ steps: [Step], speech: () async throws -> Void, text: () async throws -> Void) async -> [Result] {
+        var results: [Result] = []
+        for step in steps {
+            let start = Date()
+            var succeeded = true
+            do {
+                switch step {
+                case .speech: try await speech()
+                case .text: try await text()
+                }
+            } catch {
+                succeeded = false
+            }
+            results.append(Result(step: step, milliseconds: Int(Date().timeIntervalSince(start) * 1000), succeeded: succeeded))
+        }
+        return results
+    }
+}
