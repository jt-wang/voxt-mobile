index 0000000..e4a41f6
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputDictationPipeline.swift
@@ -0,0 +1,283 @@
+// RemoteInputDictationPipeline.swift
+// Provides the audio-to-text steps for one Remote Input dictation, with the Voxt-specific
+// work (ASR, enhancement, dictionary, history) injected by the app.
+
+import Foundation
+
+struct RemoteInputFinalText: Equatable {
+    var text: String
+    var dictionaryHitTerms: [String] = []
+    var dictionaryCorrectedTerms: [String] = []
+}
+
+struct RemoteInputDictationOutcome: Equatable {
+    var id: UUID
+    var text: String
+    var rawText: String
+    var usedEnhancement: Bool
+    var transcriptionSeconds: TimeInterval
+    var enhancementSeconds: TimeInterval?
+    var dictionaryHitTerms: [String]
+    var dictionaryCorrectedTerms: [String]
+    var mode: RemoteInputComposeMode = .dictate
+}
+
+private struct RemoteInputDictationResponseBody: Encodable {
+    var id: String
+    var text: String
+    var rawText: String
+    var asrMs: Int
+    var enhanceMs: Int
+    var mode: RemoteInputComposeMode = .dictate
+    var status: String?
+    var message: String?
+}
+
+final class RemoteInputDictationPipeline {
+    let temporaryDirectory: URL
+    /// Returns why the Mac can't take a dictation right now (it is recording, in a meeting, …).
+    let busyReason: () -> String?
+    /// Audio file → normalized transcript, using the engine selected in Voxt.
+    let transcribe: (URL, String?) async throws -> String
+    /// Transcript → cleaned-up text, using Voxt's transcription enhancement settings.
+    let enhance: (String) async throws -> String
+    /// Raw transcript → mode-specific result (cleanup, translate, edit, write), using the
+    /// same selected text model through a strict path that never returns raw speech.
+    var composeHandler: ((String, RemoteInputComposeOptions) async throws -> String)?
+    /// Original passage + correction instruction → the selected text model's raw output.
+    /// Corrections do not transcribe audio and do not write history.
+    var correctHandler: ((RemoteInputCorrectionRequest, String) async throws -> String)?
+    /// Applies dictionary corrections to the final text.
+    let finalize: (String) -> RemoteInputFinalText
+    let record: (RemoteInputDictationOutcome) -> Void
+
+    private var isRunning = false
+
+    init(
+        temporaryDirectory: URL,
+        busyReason: @escaping () -> String?,
+        transcribe: @escaping (URL, String?) async throws -> String,
+        enhance: @escaping (String) async throws -> String,
+        finalize: @escaping (String) -> RemoteInputFinalText,
+        record: @escaping (RemoteInputDictationOutcome) -> Void
+    ) {
+        self.temporaryDirectory = temporaryDirectory
+        self.busyReason = busyReason
+        self.transcribe = transcribe
+        self.enhance = enhance
+        self.finalize = finalize
+        self.record = record
+    }
+
+    func run(_ request: RemoteInputDictationRequest) async -> RemoteInputHTTPResponse {
+        if let reason = busyReason() {
+            return .error(status: 503, reason)
+        }
+        guard !isRunning else {
+            return .error(status: 503, "Voxt is still working on the previous remote dictation.")
+        }
+        isRunning = true
+        defer { isRunning = false }
+
+        let audioURL = temporaryDirectory.appendingPathComponent("remote-input-\(UUID().uuidString).\(request.fileExtension)")
+        defer { try? FileManager.default.removeItem(at: audioURL) }
+
+        let rawText: String
+        let transcriptionStart = Date()
+        do {
+            try request.audio.write(to: audioURL, options: .atomic)
+            rawText = try await transcribe(audioURL, request.language).trimmingCharacters(in: .whitespacesAndNewlines)
+        } catch {
+            VoxtLog.warning("Remote input transcription failed: \(error.localizedDescription)")
+            return .error(status: 500, error.localizedDescription)
+        }
+        let transcriptionSeconds = Date().timeIntervalSince(transcriptionStart)
+
+        guard !rawText.isEmpty else {
+            return .error(status: 422, "No speech detected.")
+        }
+
+        var text = rawText
+        var usedEnhancement = false
+        var enhancementSeconds: TimeInterval?
+        if request.enhance {
+            let enhancementStart = Date()
+            do {
+                let enhanced = try await enhance(rawText).trimmingCharacters(in: .whitespacesAndNewlines)
+                if !enhanced.isEmpty {
+                    text = enhanced
+                    usedEnhancement = true
+                }
+            } catch {
+                VoxtLog.warning("Remote input enhancement failed, returning raw transcript: \(error.localizedDescription)")
+            }
+            enhancementSeconds = Date().timeIntervalSince(enhancementStart)
+        }
+
+        return finish(
+            mode: .dictate,
+            rawText: rawText,
+            text: text,
+            usedEnhancement: usedEnhancement,
+            transcriptionSeconds: transcriptionSeconds,
+            enhancementSeconds: enhancementSeconds
+        )
+    }
+
+    /// Every compose mode requires a working text model. Dictate restores the ASR text
+    /// when cleanup changes its script; other model failures remain errors.
+    func runCompose(_ request: RemoteInputComposeRequest) async -> RemoteInputHTTPResponse {
+        if let reason = busyReason() {
+            return .error(status: 503, reason)
+        }
+        guard !isRunning else {
+            return .error(status: 503, "Voxt is still working on the previous remote dictation.")
+        }
+        isRunning = true
+        defer { isRunning = false }
+
+        let audioURL = temporaryDirectory.appendingPathComponent("remote-input-\(UUID().uuidString).\(request.fileExtension)")
+        defer { try? FileManager.default.removeItem(at: audioURL) }
+
+        let rawText: String
+        let transcriptionStart = Date()
+        do {
+            try request.audio.write(to: audioURL, options: .atomic)
+            rawText = try await transcribe(audioURL, request.language).trimmingCharacters(in: .whitespacesAndNewlines)
+        } catch {
+            VoxtLog.warning("Remote input compose transcription failed: \(error.localizedDescription)")
+            return .error(status: 500, error.localizedDescription)
+        }
+        let transcriptionSeconds = Date().timeIntervalSince(transcriptionStart)
+
+        guard !rawText.isEmpty else {
+            return .error(status: 422, "No speech detected.")
+        }
+
+        guard let composeHandler else {
+            return .error(status: 503, "No text model is available for this operation.")
+        }
+        let enhancementStart = Date()
+        let text: String
+        do {
+            let composed = try await composeHandler(rawText, request.options)
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !composed.isEmpty else {
+                return .error(status: 503, "The text model returned nothing.")
+            }
+            if request.options.mode == .dictate {
+                text = RemoteInputComposePrompt.preservingDictationScript(composed, rawText: rawText)
+                if text != composed {
+                    VoxtLog.warning("Remote input dictate cleanup discarded: transcript script changed.")
+                }
+            } else {
+                text = composed
+            }
+        } catch is RemoteInputComposePrompt.EditNotApplied {
+            // No dictionary finalization or successful history entry: the selection
+            // must remain byte-for-byte unchanged when the edit could not be applied.
+            return .json(status: 200, RemoteInputDictationResponseBody(
+                id: UUID().uuidString, text: request.options.selectedText, rawText: rawText,
+                asrMs: Int(transcriptionSeconds * 1000),
+                enhanceMs: Int(Date().timeIntervalSince(enhancementStart) * 1000),
+                mode: request.options.mode, status: "not_applied", message: "Couldn't apply that edit"
+            ))
+        } catch {
+            VoxtLog.warning("Remote input compose failed: \(error.localizedDescription)")
+            return .error(status: 503, error.localizedDescription)
+        }
+        let enhancementSeconds = Date().timeIntervalSince(enhancementStart)
+
+        return finish(
+            mode: request.options.mode,
+            rawText: rawText,
+            text: text,
+            usedEnhancement: true,
+            transcriptionSeconds: transcriptionSeconds,
+            enhancementSeconds: enhancementSeconds
+        )
+    }
+
+    /// Handles POST /v1/corrections. Shares the busy and in-flight guard with dictation
+    /// and compose, then returns one validated word pair or null. Nothing is recorded.
+    func runCorrection(_ request: RemoteInputCorrectionRequest) async -> RemoteInputHTTPResponse {
+        if let reason = busyReason() {
+            return .error(status: 503, reason)
+        }
+        guard !isRunning else {
+            return .error(status: 503, "Voxt is still working on the previous remote dictation.")
+        }
+        isRunning = true
+        defer { isRunning = false }
+
+        if RemoteInputCorrection.isIgnorable(original: request.original, edited: request.edited) {
+            return .json(status: 200, RemoteInputCorrectionResponse(correction: nil))
+        }
+        guard let correctHandler else {
+            return .error(status: 503, "No text model is available for this operation.")
+        }
+        let instruction = RemoteInputCorrectionPrompt.instruction(original: request.original, edited: request.edited)
+        let output: String
+        do {
+            output = try await correctHandler(request, instruction)
+                .trimmingCharacters(in: .whitespacesAndNewlines)
+        } catch {
+            VoxtLog.warning("Remote input correction failed: \(error.localizedDescription)")
+            return .error(status: 503, error.localizedDescription)
+        }
+        guard !output.isEmpty else {
+            return .error(status: 503, "The text model returned nothing.")
+        }
+        do {
+            let pair = try RemoteInputCorrection.interpret(
+                modelOutput: output,
+                original: request.original,
+                edited: request.edited
+            )
+            return .json(status: 200, RemoteInputCorrectionResponse(correction: pair))
+        } catch let failure as RemoteInputCorrectionFailure {
+            let message: String
+            switch failure {
+            case .invalidJSON:
+                message = "The text model did not return valid correction JSON."
+            case .mismatch:
+                message = "The text model returned a correction that does not match the edit."
+            }
+            return .error(status: 503, message)
+        } catch {
+            return .error(status: 503, error.localizedDescription)
+        }
+    }
+
+    private func finish(
+        mode: RemoteInputComposeMode,
+        rawText: String,
+        text: String,
+        usedEnhancement: Bool,
+        transcriptionSeconds: TimeInterval,
+        enhancementSeconds: TimeInterval?
+    ) -> RemoteInputHTTPResponse {
+        let final = finalize(text)
+        let outcome = RemoteInputDictationOutcome(
+            id: UUID(),
+            text: final.text,
+            rawText: rawText,
+            usedEnhancement: usedEnhancement,
+            transcriptionSeconds: transcriptionSeconds,
+            enhancementSeconds: enhancementSeconds,
+            dictionaryHitTerms: final.dictionaryHitTerms,
+            dictionaryCorrectedTerms: final.dictionaryCorrectedTerms,
+            mode: mode
+        )
+        record(outcome)
+
+        return .json(status: 200, RemoteInputDictationResponseBody(
+            id: outcome.id.uuidString,
+            text: outcome.text,
+            rawText: outcome.rawText,
+            asrMs: Int(transcriptionSeconds * 1000),
+            enhanceMs: Int((enhancementSeconds ?? 0) * 1000),
+            mode: mode
+        ))
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputHTTP.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputHTTP.swift
new file mode 100644
index 0000000..bfe2c7b
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputHTTP.swift
@@ -0,0 +1,134 @@
+// RemoteInputHTTP.swift
+// Provides the minimal HTTP/1.1 request parsing and response encoding used by the Remote Input server.
+
+import Foundation
+
+nonisolated struct RemoteInputHTTPRequest: Equatable, Sendable {
+    var method: String
+    var path: String
+    var query: [String: String]
+    /// Header names are stored lowercased.
+    var headers: [String: String]
+    var body: Data
+
+    init(method: String, path: String, query: [String: String] = [:], headers: [String: String] = [:], body: Data = Data()) {
+        self.method = method
+        self.path = path
+        self.query = query
+        self.headers = Dictionary(headers.map { ($0.key.lowercased(), $0.value) }, uniquingKeysWith: { _, last in last })
+        self.body = body
+    }
+
+    func header(_ name: String) -> String? {
+        headers[name.lowercased()]
+    }
+}
+
+nonisolated enum RemoteInputHTTPParseResult: Equatable, Sendable {
+    case incomplete
+    case complete(RemoteInputHTTPRequest, consumed: Int)
+    /// The HTTP status to answer with before closing the connection.
+    case failure(Int)
+}
+
+nonisolated enum RemoteInputHTTPParser {
+    static let maxHeaderBytes = 16 * 1024
+    private static let headerTerminator = Data("\r\n\r\n".utf8)
+
+    /// Parses one request from the start of `data`. Only `Content-Length` bodies are accepted;
+    /// clients that stream chunked bodies get 411.
+    static func parse(_ data: Data, maxBodyBytes: Int) -> RemoteInputHTTPParseResult {
+        guard let terminator = data.range(of: headerTerminator) else {
+            return data.count > maxHeaderBytes ? .failure(431) : .incomplete
+        }
+        guard terminator.lowerBound - data.startIndex <= maxHeaderBytes else { return .failure(431) }
+        guard let head = String(data: data[data.startIndex..<terminator.lowerBound], encoding: .utf8) else {
+            return .failure(400)
+        }
+
+        var lines = head.components(separatedBy: "\r\n")
+        let requestLine = lines.removeFirst().split(separator: " ", omittingEmptySubsequences: true)
+        guard requestLine.count == 3, requestLine[2].hasPrefix("HTTP/1."),
+              let components = URLComponents(string: String(requestLine[1])) else {
+            return .failure(400)
+        }
+
+        var headers: [String: String] = [:]
+        for line in lines where !line.isEmpty {
+            guard let colon = line.firstIndex(of: ":") else { return .failure(400) }
+            let name = line[..<colon].trimmingCharacters(in: .whitespaces).lowercased()
+            headers[name] = line[line.index(after: colon)...].trimmingCharacters(in: .whitespaces)
+        }
+
+        if let encoding = headers["transfer-encoding"], encoding.lowercased() != "identity" {
+            return .failure(411)
+        }
+        var bodyLength = 0
+        if let lengthText = headers["content-length"] {
+            guard let length = Int(lengthText), length >= 0 else { return .failure(400) }
+            bodyLength = length
+        }
+        guard bodyLength <= maxBodyBytes else { return .failure(413) }
+
+        let bodyStart = terminator.upperBound
+        guard data.endIndex - bodyStart >= bodyLength else { return .incomplete }
+        let body = Data(data[bodyStart..<(bodyStart + bodyLength)])
+
+        var query: [String: String] = [:]
+        for item in components.queryItems ?? [] { query[item.name] = item.value ?? "" }
+
+        let request = RemoteInputHTTPRequest(
+            method: String(requestLine[0]).uppercased(),
+            path: components.path,
+            query: query,
+            headers: headers,
+            body: body
+        )
+        return .complete(request, consumed: bodyStart + bodyLength - data.startIndex)
+    }
+}
+
+nonisolated struct RemoteInputHTTPResponse: Equatable, Sendable {
+    var status: Int
+    var contentType: String
+    var body: Data
+
+    static func json(status: Int, _ object: some Encodable) -> RemoteInputHTTPResponse {
+        let encoder = JSONEncoder()
+        encoder.outputFormatting = [.sortedKeys, .withoutEscapingSlashes]
+        let body = (try? encoder.encode(object)) ?? Data("{}".utf8)
+        return RemoteInputHTTPResponse(status: status, contentType: "application/json; charset=utf-8", body: body)
+    }
+
+    static func error(status: Int, _ message: String) -> RemoteInputHTTPResponse {
+        json(status: status, ["error": message])
+    }
+
+    func serialized() -> Data {
+        var head = "HTTP/1.1 \(status) \(Self.reasonPhrase(status))\r\n"
+        head += "Content-Type: \(contentType)\r\n"
+        head += "Content-Length: \(body.count)\r\n"
+        head += "Cache-Control: no-store\r\n"
+        head += "Connection: close\r\n\r\n"
+        return Data(head.utf8) + body
+    }
+
+    static func reasonPhrase(_ status: Int) -> String {
+        switch status {
+        case 200: "OK"
+        case 400: "Bad Request"
+        case 401: "Unauthorized"
+        case 403: "Forbidden"
+        case 404: "Not Found"
+        case 409: "Conflict"
+        case 405: "Method Not Allowed"
+        case 411: "Length Required"
+        case 413: "Content Too Large"
+        case 415: "Unsupported Media Type"
+        case 422: "Unprocessable Content"
+        case 431: "Request Header Fields Too Large"
+        case 503: "Service Unavailable"
+        default: status < 500 ? "Client Error" : "Internal Server Error"
+        }
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputRequestHandler.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputRequestHandler.swift
new file mode 100644
index 0000000..b137591
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputRequestHandler.swift
@@ -0,0 +1,91 @@
+// RemoteInputRequestHandler.swift
+// Provides the Remote Input request handler. Parsing, token checks and health answers stay off
+// the main actor, so an idle or busy Voxt still answers quickly; only dictations hop to it.
+
+import Foundation
+
+nonisolated struct RemoteInputCapabilities: Codable, Equatable, Sendable {
+    var transcription: String
+    var text: String
+
+    static func resolve(transcriptionEngine: String, enhancementMode: String,
+                        appleSpeechOnDevice: Bool = false) -> Self {
+        let transcription: String
+        switch transcriptionEngine {
+        case "mlxAudio": transcription = "local"
+        case "remote": transcription = "remote"
+        // SpeechTranscriber.startSpeechRecognition sets
+        // requiresOnDeviceRecognition from this setting; false permits network use.
+        case "dictation": transcription = appleSpeechOnDevice ? "local" : "unknown"
+        default: transcription = "unknown"
+        }
+        let text: String
+        switch enhancementMode {
+        case "customLLM", "off": text = "local"
+        // TextEnhancer uses FoundationModels SystemLanguageModel.default.
+        // Apple describes it as on-device:
+        // https://developer.apple.com/documentation/foundationmodels/systemlanguagemodel
+        case "appleIntelligence": text = "local"
+        case "remoteLLM": text = "remote"
+        default: text = "unknown"
+        }
+        return Self(transcription: transcription, text: text)
+    }
+}
+
+nonisolated enum RemoteInputRequestHandler {
+    private struct Health: Encodable {
+        var ok: Bool
+        var app: String
+        var version: String
+    }
+
+    static func make(
+        router: RemoteInputRouter,
+        version: String,
+        dictate: @escaping @MainActor @Sendable (RemoteInputDictationRequest) async -> RemoteInputHTTPResponse,
+        compose: @escaping @MainActor @Sendable (RemoteInputComposeRequest) async -> RemoteInputHTTPResponse,
+        correct: @escaping @MainActor @Sendable (RemoteInputCorrectionRequest) async -> RemoteInputHTTPResponse = { _ in
+            .error(status: 503, "No text model is available for this operation.")
+        },
+        capabilities: @escaping @MainActor @Sendable () -> RemoteInputCapabilities = {
+            .init(transcription: "unknown", text: "unknown")
+        },
+        sync: @escaping @Sendable (HistorySyncRequest) -> RemoteInputHTTPResponse = { _ in
+            .error(status: 403, "History sync is turned off.")
+        }
+    ) -> RemoteInputServer.Handler {
+        { request in
+            let route = router.route(request)
+            if request.header("x-voxt-model-policy") == "local-only" {
+                switch route {
+                case .dictation, .compose, .correction:
+                    let models = await capabilities()
+                    guard models.transcription == "local", models.text == "local" else {
+                        let remote = models.transcription == "remote" || models.text == "remote"
+                        return .error(status: 403, remote ? "Your Mac is set to a cloud model" : "Could not verify that your Mac uses local models.")
+                    }
+                default: break
+                }
+            }
+            switch route {
+            case .health:
+                return .json(status: 200, Health(ok: true, app: "Voxt", version: version))
+            case .capabilities:
+                return .json(status: 200, await capabilities())
+            case .composePrompts:
+                return .json(status: 200, ["prompts": RemoteInputComposePrompt.builtInPrompts()])
+            case let .reject(response):
+                return response
+            case let .dictation(dictation):
+                return await dictate(dictation)
+            case let .compose(composeRequest):
+                return await compose(composeRequest)
+            case let .correction(correction):
+                return await correct(correction)
+            case let .historySync(request):
+                return sync(request)
+            }
+        }
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputRouter.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputRouter.swift
new file mode 100644
index 0000000..5a7936d
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputRouter.swift
@@ -0,0 +1,195 @@
+// RemoteInputRouter.swift
+// Provides token checks and request routing for the Remote Input server.
+
+import Foundation
+import Security
+
+nonisolated struct RemoteInputDictationRequest: Equatable, Sendable {
+    var audio: Data
+    var fileExtension: String
+    var enhance: Bool
+    var language: String? = nil
+}
+
+nonisolated struct RemoteInputComposeRequest: Equatable, Sendable {
+    var audio: Data
+    var fileExtension: String
+    var options: RemoteInputComposeOptions
+    var language: String? = nil
+}
+
+private struct RemoteInputComposeRequestBody: Decodable {
+    var audio: String
+    var contentType: String
+    var options: RemoteInputComposeOptions
+    var language: String? = nil
+}
+
+nonisolated enum RemoteInputRoute: Equatable, Sendable {
+    case health
+    case capabilities
+    /// The built-in compose instructions, for the phone's Developer prompt editor.
+    case composePrompts
+    case dictation(RemoteInputDictationRequest)
+    case compose(RemoteInputComposeRequest)
+    case correction(RemoteInputCorrectionRequest)
+    case historySync(HistorySyncRequest)
+    case reject(RemoteInputHTTPResponse)
+}
+
+nonisolated struct RemoteInputRouter: Sendable {
+    /// Audio types AVAudioFile can read, mapped to the file extension it needs.
+    static let audioExtensions: [String: String] = [
+        "audio/wav": "wav",
+        "audio/wave": "wav",
+        "audio/x-wav": "wav",
+        "audio/mp4": "m4a",
+        "audio/m4a": "m4a",
+        "audio/x-m4a": "m4a",
+        "audio/aac": "aac",
+        "audio/mpeg": "mp3",
+        "audio/x-caf": "caf",
+    ]
+
+    let token: String
+    let maxBodyBytes: Int
+
+    func route(_ request: RemoteInputHTTPRequest) -> RemoteInputRoute {
+        guard isAuthorized(request) else {
+            return .reject(.error(status: 401, "Missing or wrong pairing token."))
+        }
+
+        switch request.path {
+        case "/v1/capabilities":
+            guard request.method == "GET" else { return .reject(.error(status: 405, "Use GET.")) }
+            return .capabilities
+        case "/v1/compose/prompts":
+            guard request.method == "GET" else { return .reject(.error(status: 405, "Use GET.")) }
+            return .composePrompts
+        case "/v1/health":
+            guard request.method == "GET" else { return .reject(.error(status: 405, "Use GET.")) }
+            return .health
+        case "/v1/dictations":
+            guard request.method == "POST" else { return .reject(.error(status: 405, "Use POST.")) }
+            guard !request.body.isEmpty else { return .reject(.error(status: 400, "The request has no audio.")) }
+            let mediaType = request.header("content-type")?
+                .split(separator: ";").first?
+                .trimmingCharacters(in: .whitespaces).lowercased() ?? ""
+            guard let fileExtension = Self.audioExtensions[mediaType] else {
+                return .reject(.error(status: 415, "Send audio/wav or audio/mp4."))
+            }
+            return .dictation(RemoteInputDictationRequest(
+                audio: request.body,
+                fileExtension: fileExtension,
+                enhance: request.query["enhance"] != "0",
+                language: request.query["language"]
+            ))
+        case "/v1/compose":
+            guard request.method == "POST" else { return .reject(.error(status: 405, "Use POST.")) }
+            let mediaType = request.header("content-type")?
+                .split(separator: ";").first?
+                .trimmingCharacters(in: .whitespaces).lowercased() ?? ""
+            guard mediaType == "application/json" else {
+                return .reject(.error(status: 415, "Send application/json."))
+            }
+            let body: RemoteInputComposeRequestBody
+            do {
+                body = try JSONDecoder().decode(RemoteInputComposeRequestBody.self, from: request.body)
+            } catch let RemoteInputComposeDecoding.styleExamples(message) {
+                return .reject(.error(status: 400, message))
+            } catch {
+                return .reject(.error(status: 400, "The compose request is not valid JSON."))
+            }
+            guard let audio = Data(base64Encoded: body.audio), !audio.isEmpty else {
+                return .reject(.error(status: 400, "The request has no audio."))
+            }
+            guard let fileExtension = Self.audioExtensions[body.contentType.lowercased()] else {
+                return .reject(.error(status: 415, "Send audio/wav or audio/mp4."))
+            }
+            if let reason = body.options.validationError() {
+                return .reject(.error(status: 400, reason))
+            }
+            return .compose(RemoteInputComposeRequest(
+                audio: audio,
+                fileExtension: fileExtension,
+                options: body.options,
+                language: body.language
+            ))
+        case "/v1/corrections":
+            guard request.method == "POST" else { return .reject(.error(status: 405, "Use POST.")) }
+            let mediaType = request.header("content-type")?
+                .split(separator: ";").first?
+                .trimmingCharacters(in: .whitespaces).lowercased() ?? ""
+            guard mediaType == "application/json" else {
+                return .reject(.error(status: 415, "Send application/json."))
+            }
+            let object: Any
+            do {
+                object = try JSONSerialization.jsonObject(with: request.body)
+            } catch {
+                return .reject(.error(status: 400, "The corrections request is not valid JSON."))
+            }
+            guard let fields = object as? [String: Any] else {
+                return .reject(.error(status: 400, "The corrections request is not valid JSON."))
+            }
+            guard let original = fields["original"] as? String, let edited = fields["edited"] as? String else {
+                return .reject(.error(status: 400, "original and edited must be strings."))
+            }
+            guard !original.isEmpty, !edited.isEmpty else {
+                return .reject(.error(status: 400, "The original and edited text must not be empty."))
+            }
+            guard original.count <= 2_000, edited.count <= 2_000 else {
+                return .reject(.error(status: 400, "Use at most 2000 characters for each passage."))
+            }
+            guard original != edited else {
+                return .reject(.error(status: 400, "The original and edited text are the same."))
+            }
+            return .correction(RemoteInputCorrectionRequest(original: original, edited: edited))
+        case "/v1/history/sync":
+            guard request.method == "POST" else { return .reject(.error(status: 405, "Use POST.")) }
+            let mediaType = request.header("content-type")?
+                .split(separator: ";").first?
+                .trimmingCharacters(in: .whitespaces).lowercased() ?? ""
+            guard mediaType == "application/json" else {
+                return .reject(.error(status: 415, "Send application/json."))
+            }
+            switch HistorySyncRequest.parse(request.body) {
+            case let .success(parsed):
+                return .historySync(parsed)
+            case let .failure(message):
+                return .reject(.error(status: 400, message))
+            }
+        default:
+            return .reject(.error(status: 404, "Unknown path."))
+        }
+    }
+
+    private func isAuthorized(_ request: RemoteInputHTTPRequest) -> Bool {
+        guard !token.isEmpty, let header = request.header("authorization"), header.hasPrefix("Bearer ") else {
+            return false
+        }
+        return Self.constantTimeEquals(Array(header.dropFirst("Bearer ".count).utf8), Array(token.utf8))
+    }
+
+    private static func constantTimeEquals(_ lhs: [UInt8], _ rhs: [UInt8]) -> Bool {
+        var difference = UInt8(truncatingIfNeeded: lhs.count ^ rhs.count)
+        for index in 0..<max(lhs.count, rhs.count) {
+            let a = index < lhs.count ? lhs[index] : 0
+            let b = index < rhs.count ? rhs[index] : 0
+            difference |= a ^ b
+        }
+        return difference == 0
+    }
+
+    /// 32 random bytes, base64url without padding (43 characters).
+    static func generateToken() -> String {
+        var bytes = [UInt8](repeating: 0, count: 32)
+        if SecRandomCopyBytes(kSecRandomDefault, bytes.count, &bytes) != errSecSuccess {
+            bytes = (0..<32).map { _ in UInt8.random(in: .min ... .max) }
+        }
+        return Data(bytes).base64EncodedString()
+            .replacingOccurrences(of: "+", with: "-")
+            .replacingOccurrences(of: "/", with: "_")
+            .replacingOccurrences(of: "=", with: "")
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputServer.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputServer.swift
new file mode 100644
index 0000000..0df2cb7
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputServer.swift
@@ -0,0 +1,125 @@
+// RemoteInputServer.swift
+// Provides the loopback-only HTTP listener behind Remote Input. Remote devices reach it through
+// a tunnel such as `tailscale serve`, never directly.
+
+import Foundation
+import Network
+
+nonisolated final class RemoteInputServer: @unchecked Sendable {
+    typealias Handler = @Sendable (RemoteInputHTTPRequest) async -> RemoteInputHTTPResponse
+
+    enum ServerError: LocalizedError {
+        case invalidPort(UInt16)
+        case failed(String)
+
+        var errorDescription: String? {
+            switch self {
+            case let .invalidPort(port): "Port \(port) can't be used."
+            case let .failed(reason): reason
+            }
+        }
+    }
+
+    /// A client that stops sending mid-request is dropped after this long.
+    static let requestTimeout: TimeInterval = 60
+
+    private let requestedPort: UInt16
+    private let maxBodyBytes: Int
+    private let handler: Handler
+    private let queue = DispatchQueue(label: "com.voxt.remote-input.server")
+    private var listener: NWListener?
+
+    init(port: UInt16, maxBodyBytes: Int, handler: @escaping Handler) {
+        requestedPort = port
+        self.maxBodyBytes = maxBodyBytes
+        self.handler = handler
+    }
+
+    /// Starts listening on 127.0.0.1 and returns the bound port (useful when `port` is 0).
+    func start() async throws -> UInt16 {
+        let port: NWEndpoint.Port
+        if requestedPort == 0 {
+            port = .any
+        } else if let fixed = NWEndpoint.Port(rawValue: requestedPort) {
+            port = fixed
+        } else {
+            throw ServerError.invalidPort(requestedPort)
+        }
+
+        let parameters = NWParameters.tcp
+        parameters.requiredLocalEndpoint = .hostPort(host: .ipv4(.loopback), port: port)
+        parameters.allowLocalEndpointReuse = true
+        let listener = try NWListener(using: parameters)
+        self.listener = listener
+
+        return try await withCheckedThrowingContinuation { continuation in
+            // All callbacks run on `queue`; the handler is cleared after the first terminal state
+            // so the continuation resumes exactly once.
+            listener.stateUpdateHandler = { [weak listener] state in
+                switch state {
+                case .ready:
+                    listener?.stateUpdateHandler = nil
+                    continuation.resume(returning: listener?.port?.rawValue ?? 0)
+                case let .failed(error):
+                    listener?.stateUpdateHandler = nil
+                    continuation.resume(throwing: ServerError.failed(error.localizedDescription))
+                case .cancelled:
+                    listener?.stateUpdateHandler = nil
+                    continuation.resume(throwing: CancellationError())
+                default:
+                    break
+                }
+            }
+            listener.newConnectionHandler = { [weak self] connection in
+                self?.accept(connection)
+            }
+            listener.start(queue: queue)
+        }
+    }
+
+    func stop() {
+        listener?.cancel()
+        listener = nil
+    }
+
+    private func accept(_ connection: NWConnection) {
+        connection.start(queue: queue)
+        let deadline = DispatchWorkItem { connection.cancel() }
+        queue.asyncAfter(deadline: .now() + Self.requestTimeout, execute: deadline)
+        receive(on: connection, buffer: Data(), deadline: deadline)
+    }
+
+    private func receive(on connection: NWConnection, buffer: Data, deadline: DispatchWorkItem) {
+        connection.receive(minimumIncompleteLength: 1, maximumLength: 256 * 1024) { [weak self] chunk, _, isComplete, error in
+            guard let self else { return connection.cancel() }
+            var buffer = buffer
+            if let chunk { buffer.append(chunk) }
+
+            switch RemoteInputHTTPParser.parse(buffer, maxBodyBytes: self.maxBodyBytes) {
+            case let .complete(request, _):
+                deadline.cancel()
+                let handler = self.handler
+                Task {
+                    let response = await handler(request)
+                    self.respond(response, on: connection)
+                }
+            case let .failure(status):
+                deadline.cancel()
+                self.respond(.error(status: status, RemoteInputHTTPResponse.reasonPhrase(status)), on: connection)
+            case .incomplete:
+                if isComplete || error != nil {
+                    deadline.cancel()
+                    connection.cancel()
+                } else {
+                    self.receive(on: connection, buffer: buffer, deadline: deadline)
+                }
+            }
+        }
+    }
+
+    private func respond(_ response: RemoteInputHTTPResponse, on connection: NWConnection) {
+        connection.send(content: response.serialized(), contentContext: .finalMessage, isComplete: true, completion: .contentProcessed { _ in
+            connection.cancel()
+        })
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputSettings.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputSettings.swift
new file mode 100644
index 0000000..46a7dce
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputSettings.swift
@@ -0,0 +1,101 @@
+// RemoteInputSettings.swift
+// Provides stored settings for the Remote Input server: on/off, port and pairing token.
+
+import Foundation
+
+nonisolated enum RemoteInputSettings {
+    static let defaultPort = 47910
+    static let maxBodyBytes = 25 * 1024 * 1024
+    static let tokenAccount = "remoteInputServerToken"
+    static let pairingScheme = "voxtmobile"
+
+    static func isEnabled(defaults: UserDefaults = .standard) -> Bool {
+        defaults.bool(forKey: AppPreferenceKey.remoteInputServerEnabled)
+    }
+
+    /// Text-history exchange with a paired phone. Missing means off.
+    static func isHistorySyncEnabled(defaults: UserDefaults = .standard) -> Bool {
+        defaults.bool(forKey: AppPreferenceKey.historySyncEnabled)
+    }
+
+    /// The history preference, not the hardcoded recording getter. Missing means on.
+    static func isHistoryRecordingEnabled(defaults: UserDefaults = .standard) -> Bool {
+        defaults.object(forKey: AppPreferenceKey.historyEnabled) as? Bool ?? true
+    }
+
+    static func port(defaults: UserDefaults = .standard) -> Int {
+        let stored = defaults.integer(forKey: AppPreferenceKey.remoteInputServerPort)
+        return (1024...65534).contains(stored) ? stored : defaultPort
+    }
+
+    /// Debug builds read the token from this variable so automated end-to-end tests know it.
+    static let tokenEnvironmentKey = "VOXT_REMOTE_INPUT_TOKEN"
+
+    private static let lock = NSLock()
+    /// A token that could not be saved (for example, an unsigned build without Keychain access).
+    /// Kept for the life of the process so the server and Settings show the same one.
+    nonisolated(unsafe) private static var unsavedToken: String?
+
+    /// Returns the pairing token, creating one the first time.
+    static func token(environment: [String: String] = ProcessInfo.processInfo.environment) -> String {
+        #if DEBUG
+        if let override = environment[tokenEnvironmentKey], !override.isEmpty {
+            return override
+        }
+        #endif
+        if let store = RemoteInputTokenStore.forCurrentProcess {
+            if let existing = try? store.read(account: tokenAccount), !existing.isEmpty {
+                return existing
+            }
+        } else if let existing = VoxtSecureStorage.string(for: tokenAccount), !existing.isEmpty {
+            return existing
+        }
+        if let unsaved = lock.withLock({ unsavedToken }) {
+            return unsaved
+        }
+        return regenerateToken()
+    }
+
+    @discardableResult
+    static func regenerateToken() -> String {
+        let token = RemoteInputRouter.generateToken()
+        let saved: Bool
+        if let store = RemoteInputTokenStore.forCurrentProcess {
+            saved = (try? store.write(token, account: tokenAccount)) != nil
+        } else {
+            saved = VoxtSecureStorage.set(token, for: tokenAccount)
+        }
+        if !saved {
+            VoxtLog.warning("Remote input token could not be saved to the Keychain; it lasts until Voxt quits.")
+        }
+        lock.withLock { unsavedToken = saved ? nil : token }
+        return token
+    }
+
+    static func resetUnsavedTokenForTesting() {
+        lock.withLock { unsavedToken = nil }
+    }
+
+    /// The HTTPS port phones use. `tailscale serve` listens on the tailnet addresses at this port,
+    /// and macOS then refuses 127.0.0.1 on the same port, so it is one above Voxt's own.
+    static func publicPort(forLocalPort port: Int) -> Int {
+        port + 1
+    }
+
+    /// The `tailscale serve` command that publishes the loopback server to the tailnet over HTTPS.
+    static func tailscaleServeCommand(port: Int) -> String {
+        "tailscale serve --bg --https=\(publicPort(forLocalPort: port)) http://127.0.0.1:\(port)"
+    }
+
+    /// `voxtmobile://pair?url=…&token=…`, shown as a QR code for the phone app.
+    static func pairingLink(baseURL: String, token: String) -> URL? {
+        var components = URLComponents()
+        components.scheme = pairingScheme
+        components.host = "pair"
+        components.queryItems = [
+            URLQueryItem(name: "url", value: baseURL),
+            URLQueryItem(name: "token", value: token),
+        ]
+        return components.url
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputTokenStore.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputTokenStore.swift
new file mode 100644
index 0000000..fffd4eb
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputTokenStore.swift
@@ -0,0 +1,83 @@
+import Foundation
+import Security
+
+/// Where the Remote Input token is kept. Voxt Omni Dev is not an App Store build, so it has no Data Protection
+/// Keychain entitlement; the token lives in the login Keychain under its own service. The Voxt Connector and paired
+/// phones hold the token, so it must survive restarts and rebuilds.
+nonisolated struct RemoteInputTokenStore: Sendable {
+    /// The login Keychain calls, separated so tests never touch the real Keychain.
+    protocol Keychain: Sendable {
+        func read(service: String, account: String) throws -> String?
+        func write(_ value: String, service: String, account: String) throws
+        func delete(service: String, account: String) throws
+    }
+
+    /// Unchanged from the earlier RemoteInputDevKeychain, so a token saved by an earlier build is still found.
+    static let liveService = "com.voxt.Voxt.omni.dev.remote-input"
+
+    /// The store for this process, or nil under XCTest: the suite stalls in SecItemCopyMatching on the real login
+    /// Keychain, so tests use VoxtSecureStorage's in-memory store instead.
+    static var forCurrentProcess: RemoteInputTokenStore? {
+        let environment = ProcessInfo.processInfo.environment
+        let underTests = environment["XCTestConfigurationFilePath"] != nil || environment["XCTestBundlePath"] != nil
+            || NSClassFromString("XCTestCase") != nil || NSClassFromString("XCTest.XCTestCase") != nil
+        return underTests ? nil : RemoteInputTokenStore(service: liveService, keychain: LoginKeychain())
+    }
+
+    let service: String
+    let keychain: any Keychain
+
+    func read(account: String) throws -> String? { try keychain.read(service: service, account: account) }
+    func write(_ value: String, account: String) throws { try keychain.write(value, service: service, account: account) }
+    func delete(account: String) throws { try keychain.delete(service: service, account: account) }
+}
+
+/// The macOS login Keychain (file-based, not the Data Protection Keychain).
+nonisolated struct LoginKeychain: RemoteInputTokenStore.Keychain {
+    enum Failure: Error { case invalidUTF8, status(OSStatus) }
+
+    func read(service: String, account: String) throws -> String? {
+        var query = Self.query(service: service, account: account)
+        query[kSecReturnData as String] = kCFBooleanTrue
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+        var result: CFTypeRef?
+        let status = SecItemCopyMatching(query as CFDictionary, &result)
+        switch status {
+        case errSecItemNotFound: return nil
+        case errSecSuccess:
+            guard let data = result as? Data, let value = String(data: data, encoding: .utf8) else { throw Failure.invalidUTF8 }
+            return value
+        default: throw Failure.status(status)
+        }
+    }
+
+    func write(_ value: String, service: String, account: String) throws {
+        let query = Self.query(service: service, account: account)
+        let data = Data(value.utf8)
+        let status = SecItemUpdate(query as CFDictionary, [kSecValueData as String: data] as CFDictionary)
+        switch status {
+        case errSecSuccess: return
+        case errSecItemNotFound:
+            var item = query
+            item[kSecValueData as String] = data
+            item[kSecAttrAccessible as String] = kSecAttrAccessibleWhenUnlockedThisDeviceOnly
+            let addStatus = SecItemAdd(item as CFDictionary, nil)
+            guard addStatus == errSecSuccess else { throw Failure.status(addStatus) }
+        default: throw Failure.status(status)
+        }
+    }
+
+    func delete(service: String, account: String) throws {
+        let status = SecItemDelete(Self.query(service: service, account: account) as CFDictionary)
+        guard status == errSecSuccess || status == errSecItemNotFound else { throw Failure.status(status) }
+    }
+
+    private static func query(service: String, account: String) -> [String: Any] {
+        [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: service,
+            kSecAttrAccount as String: account,
+            kSecUseDataProtectionKeychain as String: kCFBooleanFalse as Any,
+        ]
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputWarmUp.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputWarmUp.swift
