index 0000000..411f439
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/ConnectorLinkServer.swift
@@ -0,0 +1,168 @@
+// ConnectorLinkServer.swift
+// Hands the Remote Input port and Access token to the signed Voxt Connector over a Unix
+// socket, after one "Allow" (or none once the user chose Always Allow).
+
+import Foundation
+import Security
+
+final class ConnectorLinkServer: @unchecked Sendable {
+    enum Decision: Sendable { case allowAlways, allowOnce, deny }
+
+    /// The Connector must be signed by Voxt's own team (read at runtime, so no team ID is
+    /// built in), with its bundle ID and the hardened runtime.
+    static func connectorRequirement(team: String) -> String {
+        #"anchor apple generic and certificate leaf[subject.OU] = ""# + team + #"" and identifier "com.voxtmobile.connector""#
+    }
+    static var defaultPath: String {
+        FileManager.default.homeDirectoryForCurrentUser
+            .appending(path: "Library/Application Support/Voxt/connector.sock").path
+    }
+
+    private let path: String
+    private let verifyPeer: (Int32) -> Bool
+    private let isRemembered: () -> Bool
+    private let remember: () -> Void
+    private let ask: () async -> Decision
+    private let credentials: () -> (port: Int, token: String)?
+    private let lock = NSLock()
+    private var listener: Int32 = -1
+
+    /// `team` is Voxt's own signing team; nil (ad-hoc or unsigned build) rejects every peer, and
+    /// the app doesn't start the link at all, so the Connector falls back to manual entry.
+    init(team: String? = ConnectorLinkServer.ownTeamIdentifier(), path: String = ConnectorLinkServer.defaultPath,
+         verifyPeer: ((Int32) -> Bool)? = nil,
+         isRemembered: @escaping () -> Bool, remember: @escaping () -> Void,
+         ask: @escaping () async -> Decision, credentials: @escaping () -> (port: Int, token: String)?) {
+        self.path = path
+        if let verifyPeer {
+            self.verifyPeer = verifyPeer
+        } else if let team {
+            let requirement = ConnectorLinkServer.connectorRequirement(team: team)
+            self.verifyPeer = { ConnectorLinkServer.verifyConnector($0, requirement: requirement) }
+        } else {
+            self.verifyPeer = { _ in false }
+        }
+        self.isRemembered = isRemembered
+        self.remember = remember
+        self.ask = ask
+        self.credentials = credentials
+    }
+
+    /// Serves one Connector request on an accepted connection, then closes it.
+    func handle(_ fd: Int32) async {
+        defer { close(fd) }
+        var timeout = timeval(tv_sec: 5, tv_usec: 0)
+        setsockopt(fd, SOL_SOCKET, SO_RCVTIMEO, &timeout, socklen_t(MemoryLayout<timeval>.size))
+        guard let request = readLine(fd), request.contains(#""op":"connect""#) else { return }
+        // No dialog and no token for a process that isn't the signed Connector.
+        guard verifyPeer(fd) else { return send(["status": "rejected", "reason": "signature"], to: fd) }
+        guard let credentials = credentials() else { return send(["status": "unavailable"], to: fd) }
+        func approved(alwaysAllowed: Bool) -> [String: Any] {
+            // The Connector connects silently at launch only after Always Allow.
+            ["status": "approved", "port": credentials.port, "token": credentials.token, "alwaysAllowed": alwaysAllowed]
+        }
+        if isRemembered() { return send(approved(alwaysAllowed: true), to: fd) }
+        send(["status": "pending"], to: fd)
+        switch await ask() {
+        case .allowAlways:
+            remember()
+            send(approved(alwaysAllowed: true), to: fd)
+        case .allowOnce:
+            send(approved(alwaysAllowed: false), to: fd)
+        case .deny:
+            send(["status": "denied"], to: fd)
+        }
+    }
+
+    func start() throws {
+        let directory = (path as NSString).deletingLastPathComponent
+        try FileManager.default.createDirectory(atPath: directory, withIntermediateDirectories: true,
+                                                attributes: [.posixPermissions: 0o700])
+        chmod(directory, 0o700)
+        unlink(path)
+        let fd = socket(AF_UNIX, SOCK_STREAM, 0)
+        var address = sockaddr_un()
+        address.sun_family = sa_family_t(AF_UNIX)
+        let bytes = Array(path.utf8)
+        guard fd >= 0, bytes.count < MemoryLayout.size(ofValue: address.sun_path) else {
+            if fd >= 0 { close(fd) }
+            throw POSIXError(.ENAMETOOLONG)
+        }
+        withUnsafeMutableBytes(of: &address.sun_path) { $0.copyBytes(from: bytes + [0]) }
+        let bound = withUnsafePointer(to: &address) {
+            $0.withMemoryRebound(to: sockaddr.self, capacity: 1) { bind(fd, $0, socklen_t(MemoryLayout<sockaddr_un>.size)) }
+        }
+        guard bound == 0, chmod(path, 0o600) == 0, listen(fd, 4) == 0 else {
+            let code = errno
+            close(fd)
+            throw POSIXError(POSIXErrorCode(rawValue: code) ?? .EIO)
+        }
+        lock.withLock { listener = fd }
+        Thread.detachNewThread { [weak self] in
+            while true {
+                let client = accept(fd, nil, nil)
+                guard client >= 0 else { return }
+                guard let self else { close(client); return }
+                Task { await self.handle(client) }
+            }
+        }
+    }
+
+    func stop() {
+        let fd = lock.withLock { () -> Int32 in let fd = listener; listener = -1; return fd }
+        guard fd >= 0 else { return }
+        shutdown(fd, SHUT_RDWR)
+        close(fd)
+        unlink(path)
+    }
+
+    private func readLine(_ fd: Int32) -> String? {
+        var data = Data()
+        var byte: UInt8 = 0
+        while data.count < 1024, read(fd, &byte, 1) == 1 {
+            if byte == 0x0A { return String(decoding: data, as: UTF8.self) }
+            data.append(byte)
+        }
+        return nil
+    }
+
+    private func send(_ fields: [String: Any], to fd: Int32) {
+        var message = fields
+        message["v"] = 1
+        guard var data = try? JSONSerialization.data(withJSONObject: message, options: [.sortedKeys]) else { return }
+        data.append(0x0A)
+        _ = data.withUnsafeBytes { write(fd, $0.baseAddress, $0.count) }
+    }
+
+    /// The peer must be the Connector signed by our team with the hardened runtime; without
+    /// the runtime an injected library passed the signature check in the fixture.
+    static func ownTeamIdentifier() -> String? {
+        var code: SecCode?
+        var staticCode: SecStaticCode?
+        var info: CFDictionary?
+        guard SecCodeCopySelf([], &code) == errSecSuccess, let code,
+              SecCodeCopyStaticCode(code, [], &staticCode) == errSecSuccess, let staticCode,
+              SecCodeCopySigningInformation(staticCode, SecCSFlags(rawValue: kSecCSSigningInformation), &info) == errSecSuccess
+        else { return nil }
+        return (info as? [String: Any])?[kSecCodeInfoTeamIdentifier as String] as? String
+    }
+
+    static func verifyConnector(_ fd: Int32, requirement requirementText: String) -> Bool {
+        var token = audit_token_t()
+        var size = socklen_t(MemoryLayout<audit_token_t>.size)
+        guard getsockopt(fd, SOL_LOCAL, LOCAL_PEERTOKEN, &token, &size) == 0 else { return false }
+        let tokenData = withUnsafeBytes(of: token) { Data($0) }
+        var code: SecCode?
+        var requirement: SecRequirement?
+        guard SecCodeCopyGuestWithAttributes(nil, [kSecGuestAttributeAudit: tokenData] as CFDictionary, [], &code) == errSecSuccess,
+              let code,
+              SecRequirementCreateWithString(requirementText as CFString, [], &requirement) == errSecSuccess, let requirement,
+              SecCodeCheckValidity(code, [], requirement) == errSecSuccess else { return false }
+        var staticCode: SecStaticCode?
+        var info: CFDictionary?
+        guard SecCodeCopyStaticCode(code, [], &staticCode) == errSecSuccess, let staticCode,
+              SecCodeCopySigningInformation(staticCode, SecCSFlags(rawValue: kSecCSSigningInformation), &info) == errSecSuccess,
+              let flags = (info as? [String: Any])?[kSecCodeInfoFlags as String] as? UInt32 else { return false }
+        return flags & 0x10000 != 0
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/HistorySync.swift b/Voxt/Voxt/Core/RemoteInput/HistorySync.swift
new file mode 100644
index 0000000..3295b73
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/HistorySync.swift
@@ -0,0 +1,244 @@
+// HistorySync.swift
+// Exchanges text history with Voxt Mobile. Revisions and deletion tombstones live in the Mac database.
+
+import Foundation
+
+struct HistorySyncStoreMismatch: Error {}
+
+enum HistorySyncParsed<Value> {
+    case success(Value)
+    case failure(String)
+}
+
+nonisolated struct HistorySyncItem: Equatable, Sendable {
+    var id: UUID
+    var text: String
+    var createdAt: TimeInterval
+    var mode: String?
+    var elapsedSeconds: TimeInterval?
+}
+
+nonisolated struct HistorySyncRequest: Equatable, Sendable {
+    var storeID: UUID?
+    var cursor: Int
+    var limit: Int
+    var items: [HistorySyncItem]
+    var deletedIDs: [UUID]
+
+    static func parse(_ data: Data) -> HistorySyncParsed<HistorySyncRequest> {
+        let object: Any
+        do {
+            guard !data.isEmpty else {
+                return .failure("The history sync request is not valid JSON.")
+            }
+            object = try JSONSerialization.jsonObject(with: data)
+        } catch {
+            return .failure("The history sync request is not valid JSON.")
+        }
+        guard let fields = object as? [String: Any] else {
+            return .failure("The history sync request is not valid JSON.")
+        }
+        let allowed = Set(["storeID", "cursor", "limit", "items", "deletedIDs"])
+        let required = ["cursor", "limit", "items", "deletedIDs"]
+        guard Set(fields.keys).isSubset(of: allowed), required.allSatisfy(fields.keys.contains) else {
+            return .failure("The history sync request has invalid fields.")
+        }
+        guard let cursor = jsonInteger(fields["cursor"]) else {
+            return .failure("History sync cursor must be a non-negative integer.")
+        }
+        guard let limit = jsonInteger(fields["limit"]), (1...200).contains(limit) else {
+            return .failure("History sync limit must be from 1 to 200.")
+        }
+        guard let rawItems = fields["items"] as? [Any], let rawDeleted = fields["deletedIDs"] as? [Any] else {
+            return .failure("The history sync request has invalid fields.")
+        }
+        if rawItems.count > 200 {
+            return .failure("History sync accepts at most 200 items.")
+        }
+        if rawDeleted.count > 200 {
+            return .failure("History sync accepts at most 200 deletions.")
+        }
+        var items: [HistorySyncItem] = []
+        items.reserveCapacity(rawItems.count)
+        for raw in rawItems {
+            switch parseItem(raw) {
+            case let .success(item):
+                items.append(item)
+            case let .failure(message):
+                return .failure(message)
+            }
+        }
+        var deletedIDs: [UUID] = []
+        deletedIDs.reserveCapacity(rawDeleted.count)
+        for raw in rawDeleted {
+            guard let id = jsonUUID(raw) else {
+                return .failure("History sync ids must be UUIDs.")
+            }
+            deletedIDs.append(id)
+        }
+        let itemIDs = items.map(\.id)
+        guard Set(itemIDs).count == itemIDs.count,
+              Set(deletedIDs).count == deletedIDs.count,
+              Set(itemIDs).isDisjoint(with: deletedIDs) else {
+            return .failure("History sync ids must be unique.")
+        }
+        switch parseStoreID(fields["storeID"]) {
+        case let .success(storeID):
+            if storeID == nil, cursor > 0 {
+                return .failure("History sync must start at cursor 0 when storeID is null.")
+            }
+            return .success(HistorySyncRequest(
+                storeID: storeID,
+                cursor: cursor,
+                limit: limit,
+                items: items,
+                deletedIDs: deletedIDs
+            ))
+        case let .failure(message):
+            return .failure(message)
+        }
+    }
+
+    private static func parseStoreID(_ value: Any?) -> HistorySyncParsed<UUID?> {
+        guard let value, !(value is NSNull) else { return .success(nil) }
+        guard let id = jsonUUID(value) else {
+            return .failure("History sync storeID must be a UUID or null.")
+        }
+        return .success(id)
+    }
+
+    private static func parseItem(_ raw: Any) -> HistorySyncParsed<HistorySyncItem> {
+        guard let fields = raw as? [String: Any] else {
+            return .failure("The history sync request has invalid fields.")
+        }
+        let allowed = Set(["id", "text", "createdAt", "mode", "elapsedSeconds"])
+        let required = ["id", "text", "createdAt"]
+        guard Set(fields.keys).isSubset(of: allowed), required.allSatisfy(fields.keys.contains) else {
+            return .failure("The history sync request has invalid fields.")
+        }
+        guard let text = fields["text"] as? String else {
+            return .failure("The history sync request has invalid fields.")
+        }
+        guard text.count <= 100_000, !text.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty else {
+            return .failure("History sync text must be 1 to 100000 characters.")
+        }
+        guard let id = jsonUUID(fields["id"]) else {
+            return .failure("History sync ids must be UUIDs.")
+        }
+        guard let createdAt = jsonFinite(fields["createdAt"]) else {
+            return .failure("History sync times must be finite.")
+        }
+        let mode: String?
+        if let value = fields["mode"], !(value is NSNull) {
+            guard let parsed = value as? String, Self.modes.contains(parsed) else {
+                return .failure("History sync mode is invalid.")
+            }
+            mode = parsed
+        } else {
+            mode = nil
+        }
+        let elapsedSeconds: TimeInterval?
+        if let value = fields["elapsedSeconds"], !(value is NSNull) {
+            guard let parsed = jsonFinite(value), parsed >= 0 else {
+                return .failure("History sync elapsed time must be a non-negative finite number.")
+            }
+            elapsedSeconds = parsed
+        } else {
+            elapsedSeconds = nil
+        }
+        return .success(HistorySyncItem(
+            id: id,
+            text: text,
+            createdAt: createdAt,
+            mode: mode,
+            elapsedSeconds: elapsedSeconds
+        ))
+    }
+
+    private static let modes: Set<String> = ["dictate", "translate", "edit", "write"]
+
+    private static func jsonUUID(_ value: Any?) -> UUID? {
+        guard let string = value as? String else { return nil }
+        return UUID(uuidString: string)
+    }
+
+    private static func jsonInteger(_ value: Any?) -> Int? {
+        guard let number = value as? NSNumber, !isJSONBool(number) else { return nil }
+        guard let integer = Int(exactly: number.doubleValue), integer >= 0 else { return nil }
+        return integer
+    }
+
+    private static func jsonFinite(_ value: Any?) -> Double? {
+        guard let number = value as? NSNumber, !isJSONBool(number) else { return nil }
+        let double = number.doubleValue
+        guard double.isFinite else { return nil }
+        return double
+    }
+
+    private static func isJSONBool(_ number: NSNumber) -> Bool {
+        CFGetTypeID(number) == CFBooleanGetTypeID()
+    }
+}
+
+nonisolated struct HistorySyncResponse: Encodable, Sendable {
+    var storeID: UUID
+    var cursor: Int
+    var hasMore: Bool
+    var items: [HistorySyncItem]
+    var deletedIDs: [UUID]
+}
+
+nonisolated struct HistorySyncState: Equatable, Sendable {
+    var storeID: UUID
+    var revision: Int
+}
+
+nonisolated struct HistorySyncChange: Equatable, Sendable {
+    var revision: Int
+    var deleted: Bool
+}
+
+extension HistorySyncItem: Encodable {
+    private enum CodingKeys: String, CodingKey {
+        case id, text, createdAt, mode, elapsedSeconds
+    }
+
+    func encode(to encoder: Encoder) throws {
+        var container = encoder.container(keyedBy: CodingKeys.self)
+        try container.encode(id, forKey: .id)
+        try container.encode(text, forKey: .text)
+        try container.encode(createdAt, forKey: .createdAt)
+        if let mode {
+            try container.encode(mode, forKey: .mode)
+        } else {
+            try container.encodeNil(forKey: .mode)
+        }
+        if let elapsedSeconds {
+            try container.encode(elapsedSeconds, forKey: .elapsedSeconds)
+        } else {
+            try container.encodeNil(forKey: .elapsedSeconds)
+        }
+    }
+}
+
+nonisolated struct HistorySyncService: Sendable {
+    var repository: HistoryRepository
+    var syncEnabled: Bool
+    var historyEnabled: Bool
+
+    func httpResponse(for request: HistorySyncRequest) -> RemoteInputHTTPResponse {
+        guard syncEnabled else {
+            return .error(status: 403, "History sync is turned off.")
+        }
+        guard historyEnabled else {
+            return .error(status: 403, "History is turned off on this Mac.")
+        }
+        do {
+            return .json(status: 200, try repository.applyHistorySync(request))
+        } catch is HistorySyncStoreMismatch {
+            return .error(status: 409, "This history sync store does not match this Mac.")
+        } catch {
+            return .error(status: 500, "History sync failed.")
+        }
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputComposeOptions.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputComposeOptions.swift
new file mode 100644
index 0000000..90fb2e4
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputComposeOptions.swift
@@ -0,0 +1,241 @@
+// RemoteInputComposeOptions.swift
+// Provides the validated options of a Remote Input compose request. The rules mirror the
+// phone's CompositionOptions exactly so a request the keyboard allowed is always accepted
+// here, and nothing else is.
+
+import Foundation
+
+nonisolated enum RemoteInputComposeMode: String, Codable, Equatable, Sendable, CaseIterable {
+    case dictate, translate, edit, write
+}
+
+nonisolated enum RemoteInputComposeStyle: String, Codable, Equatable, Sendable, CaseIterable {
+    case automatic, formal, casual, concise
+}
+
+/// One phone-kept wording pair. It exists only on the compose request. Nothing here is stored.
+nonisolated struct RemoteInputStyleExample: Equatable, Sendable {
+    var before: String
+    var after: String
+
+    static func digitSequences(in text: String) -> [String] {
+        var sequences: [String] = []
+        var current = ""
+        for character in text {
+            let isDigit = character.unicodeScalars.allSatisfy { $0.value >= 48 && $0.value <= 57 }
+            if isDigit {
+                current.append(character)
+            } else if !current.isEmpty {
+                sequences.append(current)
+                current = ""
+            }
+        }
+        if !current.isEmpty { sequences.append(current) }
+        return sequences
+    }
+}
+
+nonisolated enum RemoteInputComposeDecoding: Error {
+    case styleExamples(String)
+}
+
+nonisolated struct RemoteInputComposeOptions: Equatable, Sendable {
+    static let maximumTargetLanguageCount = 64
+    static let maximumSelectedTextCount = 8_000
+    static let maximumContextCount = 2_000
+    static let maximumVocabularyCount = 200
+    static let maximumVocabularyTermCount = 100
+    static let maximumCustomPromptCount = 4_000
+
+    /// One regional variant per language base; anything else is rejected.
+    static let allowedLanguageVariants: Set<String> = [
+        "en-US", "en-GB", "en-AU", "en-CA",
+        "zh-Hans", "zh-Hant",
+        "es-ES", "es-MX",
+        "fr-FR", "fr-CA",
+        "pt-PT", "pt-BR",
+    ]
+
+    var mode: RemoteInputComposeMode = .dictate
+    var targetLanguage: String?
+    var selectedText: String = ""
+    var contextBefore: String = ""
+    var contextAfter: String = ""
+    var style: RemoteInputComposeStyle = .automatic
+    var vocabulary: [String] = []
+    var languageVariants: [String] = []
+    var styleExamples: [RemoteInputStyleExample] = []
+    /// A paired phone's Developer prompt for this mode. It replaces the built-in instruction
+    /// for this one request; nothing is stored. nil uses the built-in prompt.
+    var customPrompt: String?
+
+    init(
+        mode: RemoteInputComposeMode = .dictate,
+        targetLanguage: String? = nil,
+        selectedText: String = "",
+        contextBefore: String = "",
+        contextAfter: String = "",
+        style: RemoteInputComposeStyle = .automatic,
+        vocabulary: [String] = [],
+        languageVariants: [String] = [],
+        styleExamples: [RemoteInputStyleExample] = []
+    ) {
+        self.mode = mode
+        self.targetLanguage = targetLanguage
+        self.selectedText = selectedText
+        self.contextBefore = contextBefore
+        self.contextAfter = contextAfter
+        self.style = style
+        self.vocabulary = vocabulary
+        self.languageVariants = languageVariants
+        self.styleExamples = styleExamples
+    }
+
+    /// nil when the options satisfy every rule, otherwise the HTTP rejection reason.
+    func validationError() -> String? {
+        if mode == .edit, selectedText.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+            return "Select the text you want to edit first."
+        }
+        if mode == .translate, targetLanguage == nil {
+            return "Choose a translation language first."
+        }
+        if let targetLanguage, !Self.isValidTargetLanguage(targetLanguage) {
+            return "Choose a valid translation language."
+        }
+        if selectedText.count > Self.maximumSelectedTextCount
+            || contextBefore.count > Self.maximumContextCount
+            || contextAfter.count > Self.maximumContextCount {
+            return "Select a shorter passage to work on."
+        }
+        if vocabulary.count > Self.maximumVocabularyCount
+            || !vocabulary.allSatisfy({ term in
+                !term.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+                    && term.count <= Self.maximumVocabularyTermCount
+            }) {
+            return "Use at most 200 dictionary entries, each up to 100 characters."
+        }
+        if !languageVariants.allSatisfy({ Self.allowedLanguageVariants.contains($0) }) {
+            return "Choose a supported language variant."
+        }
+        let variantBases = languageVariants.map { variant in
+            variant.split(separator: "-").first.map(String.init) ?? variant
+        }
+        if Set(variantBases).count != variantBases.count {
+            return "Pick at most one variant per language."
+        }
+        if let styleError = Self.styleExampleError(styleExamples) {
+            return styleError
+        }
+        if let customPrompt, customPrompt.count > Self.maximumCustomPromptCount {
+            return "Use a custom prompt of at most 4,000 characters."
+        }
+        return nil
+    }
+
+    /// Semantic limits for pairs that already decoded. Structure errors are thrown earlier.
+    static func styleExampleError(_ examples: [RemoteInputStyleExample]) -> String? {
+        if examples.count > 8 {
+            return "Use at most 8 personal style examples."
+        }
+        var seen: Set<String> = []
+        for example in examples {
+            if example.before.isEmpty || example.after.isEmpty
+                || example.before.count > 120 || example.after.count > 120 {
+                return "A personal style example must be 1 to 120 characters."
+            }
+            if example.before.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty
+                || example.after.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty {
+                return "A personal style example must not be blank."
+            }
+            if example.before == example.after {
+                return "The personal style example texts must differ."
+            }
+            if RemoteInputStyleExample.digitSequences(in: example.before)
+                != RemoteInputStyleExample.digitSequences(in: example.after) {
+                return "Personal style examples must keep the same digit sequences."
+            }
+            let identity = example.before + "\u{0}" + example.after
+            if !seen.insert(identity).inserted {
+                return "Personal style examples must not repeat."
+            }
+        }
+        return nil
+    }
+
+    /// A well-formed BCP-47 label whose base subtag is an ISO language. This says nothing
+    /// about which languages the selected models actually support.
+    static func isValidTargetLanguage(_ tag: String) -> Bool {
+        let base = tag.split(separator: "-").first.map(String.init)?.lowercased() ?? ""
+        return tag.count <= maximumTargetLanguageCount
+            && tag.range(of: "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$", options: .regularExpression) != nil
+            && Locale.isoLanguageCodes.contains(base)
+    }
+}
+
+extension RemoteInputComposeOptions: Decodable {
+    enum CodingKeys: String, CodingKey {
+        case mode, targetLanguage, selectedText, contextBefore, contextAfter, style, vocabulary, languageVariants, styleExamples, customPrompt
+    }
+
+    init(from decoder: Decoder) throws {
+        let container = try decoder.container(keyedBy: CodingKeys.self)
+        mode = try container.decodeIfPresent(RemoteInputComposeMode.self, forKey: .mode) ?? .dictate
+        targetLanguage = try container.decodeIfPresent(String.self, forKey: .targetLanguage)
+        selectedText = try container.decodeIfPresent(String.self, forKey: .selectedText) ?? ""
+        contextBefore = try container.decodeIfPresent(String.self, forKey: .contextBefore) ?? ""
+        contextAfter = try container.decodeIfPresent(String.self, forKey: .contextAfter) ?? ""
+        style = try container.decodeIfPresent(RemoteInputComposeStyle.self, forKey: .style) ?? .automatic
+        vocabulary = try container.decodeIfPresent([String].self, forKey: .vocabulary) ?? []
+        languageVariants = try container.decodeIfPresent([String].self, forKey: .languageVariants) ?? []
+        styleExamples = try Self.decodeStyleExamples(from: container)
+        let prompt = try container.decodeIfPresent(String.self, forKey: .customPrompt)?.trimmingCharacters(in: .whitespacesAndNewlines)
+        customPrompt = prompt?.isEmpty == false ? prompt : nil
+    }
+
+    private static func decodeStyleExamples(from container: KeyedDecodingContainer<CodingKeys>) throws -> [RemoteInputStyleExample] {
+        guard container.contains(.styleExamples) else { return [] }
+        if try container.decodeNil(forKey: .styleExamples) {
+            throw RemoteInputComposeDecoding.styleExamples("The personal style request has invalid fields.")
+        }
+        let decoded: [StyleExampleObject]
+        do {
+            decoded = try container.decode([StyleExampleObject].self, forKey: .styleExamples)
+        } catch let error as RemoteInputComposeDecoding {
+            throw error
+        } catch {
+            throw RemoteInputComposeDecoding.styleExamples("The personal style request has invalid fields.")
+        }
+        return decoded.map { RemoteInputStyleExample(before: $0.before, after: $0.after) }
+    }
+}
+
+private struct StyleExampleObject: Decodable {
+    var before: String
+    var after: String
+
+    private struct AnyKey: CodingKey {
+        var stringValue: String
+        var intValue: Int?
+        init?(stringValue: String) { self.stringValue = stringValue }
+        init?(intValue: Int) {
+            self.intValue = intValue
+            self.stringValue = "\(intValue)"
+        }
+    }
+
+    private enum Field: String, CodingKey { case before, after }
+
+    init(from decoder: Decoder) throws {
+        let present = try decoder.container(keyedBy: AnyKey.self)
+        guard Set(present.allKeys.map(\.stringValue)) == ["before", "after"] else {
+            throw RemoteInputComposeDecoding.styleExamples("The personal style request has invalid fields.")
+        }
+        let fields = try decoder.container(keyedBy: Field.self)
+        guard let before = try? fields.decode(String.self, forKey: .before),
+              let after = try? fields.decode(String.self, forKey: .after) else {
+            throw RemoteInputComposeDecoding.styleExamples("The personal style request has invalid fields.")
+        }
+        self.before = before
+        self.after = after
+    }
+}
diff --git a/Voxt/Voxt/Core/RemoteInput/RemoteInputComposePrompt.swift b/Voxt/Voxt/Core/RemoteInput/RemoteInputComposePrompt.swift
new file mode 100644
index 0000000..980be6c
--- /dev/null
+++ b/Voxt/Voxt/Core/RemoteInput/RemoteInputComposePrompt.swift
@@ -0,0 +1,1024 @@
+// RemoteInputComposePrompt.swift
+// Provides the mode-specific instruction that replaces the global transcription prompt for
+// one Remote Input compose request. The raw speech reaches the model through the same
+// template variable the global prompt uses.
+
+import Foundation
+
+nonisolated enum RemoteInputComposePrompt {
+    static func hanShare(in text: String) -> Double? {
+        let letters = text.unicodeScalars.filter { CharacterSet.letters.contains($0) }
+        guard !letters.isEmpty else { return nil }
+        let hanCount = letters.filter { scalar in
+            switch scalar.value {
+            case 0x3400...0x4DBF, 0x4E00...0x9FFF, 0xF900...0xFAFF, 0x20000...0x323AF: return true
+            default: return false
+            }
+        }.count
+        return Double(hanCount) / Double(letters.count)
+    }
+
+    static func preservingDictationScript(_ cleanedText: String, rawText: String) -> String {
+        guard let rawShare = hanShare(in: rawText), let cleanedShare = hanShare(in: cleanedText) else {
+            return cleanedText
+        }
+        let changedScript = (rawShare >= 0.5 && cleanedShare <= 0.1)
+            || (rawShare <= 0.1 && cleanedShare >= 0.5)
+        return changedScript ? rawText : cleanedText
+    }
+
+    /// A mixed transcript needs at least two Han characters and four Latin letters.
+    /// Below that, a single initial or symbol is too little evidence for a retry.
+    /// Count loss, not language dominance: a short Chinese span inside English matters.
+    static func losesMixedDictationContent(_ output: String, rawText: String) -> Bool {
+        func counts(_ text: String) -> (han: Int, latinLetters: Int, latinWords: Int) {
+            let han = text.unicodeScalars.filter { scalar in
+                switch scalar.value {
+                case 0x3400...0x4DBF, 0x4E00...0x9FFF, 0xF900...0xFAFF, 0x20000...0x323AF: return true
+                default: return false
+                }
+            }.count
+            let regex = try? NSRegularExpression(pattern: #"\p{Latin}+"#)
+            let words = (regex?.matches(in: text, range: NSRange(text.startIndex..., in: text)) ?? []).compactMap { match in
+                Range(match.range, in: text).map { String(text[$0]) }
+            }
+            return (han, words.reduce(0) { $0 + $1.unicodeScalars.count }, words.count)
+        }
+        let source = counts(rawText)
+        guard source.han >= 2, source.latinLetters >= 4 else { return false }
+        let result = counts(output)
+        return Double(result.han) < Double(source.han) * 0.3
+            || Double(result.latinWords) < Double(source.latinWords) * 0.3
+    }
+
+    /// The selected text model as compose needs to see it. Every compose mode consults the
+    /// model; the cases describe whether the currently selected model can run it at all.
+    enum TextModel: Equatable, Sendable {
+        case disabled
+        case customLLM(ready: Bool)
+        case remoteLLM(configured: Bool)
+        case appleIntelligence
+    }
+
+    /// nil when the model can run compose operations, otherwise the failure reason.
+    static func unavailabilityReason(for model: TextModel) -> String? {
+        switch model {
+        case .disabled, .customLLM(ready: false), .remoteLLM(configured: false):
+            "No text model is available. Choose one in Voxt Settings > Transcription."
+        case .customLLM(ready: true), .remoteLLM(configured: true), .appleIntelligence:
+            nil
+        }
+    }
+
+    /// The instruction that replaces the global transcription prompt for one compose
+    /// request. Every mode — dictate included — runs through the selected text model;
+    /// only /v1/dictations keeps the legacy global prompt.
+    /// Stored wording pairs never override an explicit tone or a translation target.
+    static func styleExamplesForPrompt(_ options: RemoteInputComposeOptions) -> [RemoteInputStyleExample] {
+        guard options.style == .automatic, options.mode != .translate else { return [] }
+        return options.styleExamples
+    }
+
+    static func instruction(
+        for options: RemoteInputComposeOptions, rawTranscription: String = "",
+        editRetry: EditRetry? = nil,
+        retryingContextLeak: Bool = false,
+        retryingWritePlaceholder: Bool = false,
+        retryingMixedDictation: Bool = false
+    ) -> String? {
+        let styleExamples = styleExamplesForPrompt(options)
+        let custom = options.customPrompt.map { $0.replacingOccurrences(of: targetLanguageTemplateVariable, with: options.targetLanguage ?? "") }
+        switch options.mode {
+        case .dictate:
+            let usesChinese = (hanShare(in: rawTranscription) ?? 0) >= 0.5
+            var task = custom ?? (retryingMixedDictation
+                ? (usesChinese ? previousChineseDictationInstruction : previousEnglishDictationInstruction)
+                : (usesChinese ? chineseDictationInstruction : englishDictationInstruction))
+            if retryingContextLeak {
+                task += usesChinese
+                    ? "\n\n第一次输出重复了输入框里已有的文字。只输出这次口述整理后的内容，不要重复光标前后的文字。"
+                    : "\n\nThe first attempt repeated text that is already in the field. Output only the cleaned transcript of this speech; never repeat the text before or after the cursor."
+            }
+            // No cursor context for plain cleanup: with it, Qwen3.5-4B copied the earlier text
+            // into 4 of 6 outputs; without it, 6 of 6 were clean in one call.
+            return body(
+                task: task,
+                selection: nil,
+                context: nil,
+                style: options.style,
+                vocabulary: options.vocabulary,
+                languageVariants: options.languageVariants,
+                styleExamples: styleExamples,
+                transcriptPrefix: usesChinese ? "口述转写：" : "Speech transcript: ",
+                outputCue: !retryingMixedDictation && !usesChinese ? "Output:" : nil
+            )
+        case .translate:
+            let target = options.targetLanguage ?? ""
+            var task = custom ?? translateTask(target: target)
+            // Qwen3.5-4B translated "Thursday... actually, Friday" literally even
+            // with examples; writing the corrected sentence first made it drop the old value.
+            let corrected = custom == nil ? appliedSelfCorrections(rawTranscription) : rawTranscription
+            let twoStep = custom == nil && corrected == rawTranscription && containsCorrectionCue(rawTranscription)
+            if twoStep {
+                task += """
+
+                First, on a line starting with "Corrected:", write the transcript in its own language with the self-corrections applied.
+                Then, on a line starting with "Translation:", write the translation of the corrected line only.
+                """
+            }
+            if custom == nil, let example = translationCorrectionExample(target: target, twoStep: twoStep) {
+                task += "\n\nExample:\n" + example
+            }
+            return body(
+                task: task,
+                selection: nil,
+                context: nil,
+                style: options.style,
+                vocabulary: options.vocabulary,
+                // The explicit translation target is authoritative. Passing other
+                // variants made Qwen3.5-4B output Chinese for target en.
+                languageVariants: [],
+                styleExamples: styleExamples,
+                transcriptPrefix: corrected == rawTranscription ? "Speech transcript: " : "Original speech (reference only; do not translate it): ",
+                afterTranscript: corrected == rawTranscription ? nil : "Translate this corrected transcript: \(corrected)",
+                outputCue: twoStep ? "Corrected:" : "Translation:"
+            )
+        case .edit:
+            let usesChinese = (hanShare(in: options.selectedText) ?? 0) >= 0.5
+            var task = custom ?? (usesChinese ? chineseEditInstruction : englishEditInstruction)
+            switch editRetry {
+            case let .droppedTerms(terms):
+                let quoted = terms.map { usesChinese ? "“\($0)”" : "\"\($0)\"" }.joined(separator: usesChinese ? "、" : ", ")
+                task += usesChinese
+                    ? "\n\n第一次输出删掉了选中文字里的日期或时间。请原样保留\(quoted)。"
+                    : "\n\nThe first attempt dropped a date or time from the selected text. Keep \(quoted) exactly as written."
+            case .leaked:
+                task += usesChinese
+                    ? "\n\n第一次输出重复了内容，或抄入了选中范围以外的文字。只输出修改后的选中文字，只输出一遍。"
+                    : "\n\nThe first attempt repeated text or copied text from around the selection. Output only the edited selected text, once."
+            case .unchanged:
+                task += usesChinese
+                    ? "\n\n第一次输出未能安全地完成修改：输出与选中文字完全相同。现在执行指令，输出必须与选中文字不同。"
+                    : "\n\nThe first attempt did not safely apply the edit: it returned the selected text unchanged. Apply the instruction now; the output must differ from the selected text."
+            case .unsafe:
+                task += usesChinese
+                    ? "\n\n第一次输出未能安全地完成修改。只输出修改后的正文，不得包含修改指令。若两个替换词发音相同，根据原文语境选择正确的写法。"
+                    : "\n\nThe first attempt did not safely apply the edit. Output only the revised passage, never the replacement instruction. If both replacement words sound the same, use the spelling that fits the selected text."
+            case nil:
+                break
+            }
+            // A whole-field edit sends the field as both selection and context. Repeating it
+            // made Qwen3.5-4B copy the text back unchanged for a tone instruction.
+            let selected = options.selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+            // A whole-field edit sends the field as both selection and context. Repeating it
+            // made Qwen3.5-4B copy the text back unchanged for a tone instruction.
+            func unlessSelection(_ context: String) -> String {
+                context.trimmingCharacters(in: .whitespacesAndNewlines) == selected ? "" : context
+            }
+            return body(
+                task: task,
+                selection: options.selectedText,
+                context: (before: unlessSelection(options.contextBefore), after: unlessSelection(options.contextAfter)),
+                style: options.style,
+                vocabulary: options.vocabulary,
+                languageVariants: options.languageVariants,
+                styleExamples: styleExamples,
+                selectionPrefix: usesChinese ? "选中文字：" : "Selected text: ",
+                transcriptPrefix: usesChinese ? "指令：" : "Instruction: ",
+                outputCue: usesChinese ? "输出：" : "Output:"
+            )
+        case .write:
+            let usesChinese = (hanShare(in: rawTranscription) ?? 0) >= 0.5
+            var task = custom ?? (usesChinese ? chineseWriteInstruction : englishWriteInstruction)
+            if retryingWritePlaceholder {
+                task += usesChinese
+                    ? "\n\n第一次输出包含占位符。不知道的姓名或细节直接省略，输出可以直接发送的完整消息。"
+                    : "\n\nThe first attempt contained a placeholder. Leave out any name or detail you do not know and output a complete message that can be sent as is."
+            }
+            return body(
+                task: task,
+                selection: nil,
+                context: (before: options.contextBefore, after: options.contextAfter),
+                style: options.style,
+                vocabulary: options.vocabulary,
+                languageVariants: options.languageVariants,
+                styleExamples: styleExamples,
+                transcriptPrefix: usesChinese ? "指令：" : "Instruction: ",
+                outputCue: usesChinese ? "消息：" : "Message:"
+            )
+        }
+    }
+
+    static func compose(
+        rawTranscription: String,
+        options: RemoteInputComposeOptions,
+        generate: (String) async throws -> String
+    ) async throws -> String {
+        // A list item is edited without its marker, which then goes back on: "2." alone was read
+        // as a time by the date guard, and the edit was not applied.
+        if options.mode == .edit, let marker = listMarker(of: options.selectedText) {
+            var item = options
+            item.selectedText = String(options.selectedText.dropFirst(marker.count))
+            let edited = try await compose(rawTranscription: rawTranscription, options: item, generate: generate)
+            return listMarker(of: edited) == nil ? marker + edited : edited
+        }
+        guard let initialPrompt = instruction(for: options, rawTranscription: rawTranscription) else {
+            throw RemoteInputError(message: "This operation has no compose prompt.")
+        }
+        let first = try await generate(initialPrompt).trimmingCharacters(in: .whitespacesAndNewlines)
+        if options.mode == .dictate, leaksContext(first, rawTranscription: rawTranscription, options: options) {
+            VoxtLog.warning("Remote input dictate output repeated the cursor context; retrying once.")
+            guard let retryPrompt = instruction(for: options, rawTranscription: rawTranscription, retryingContextLeak: true) else {
+                return rawTranscription
+            }
+            let retried = try await generate(retryPrompt).trimmingCharacters(in: .whitespacesAndNewlines)
+            guard !retried.isEmpty, !leaksContext(retried, rawTranscription: rawTranscription, options: options) else {
+                VoxtLog.warning("Remote input dictate output repeated the cursor context after retry; returning raw transcript.")
+                return rawTranscription
+            }
+            return laidOutMessage(numberedCountedLines(appliedSelfCorrections(retried)))
+        }
+        if options.mode == .dictate, losesMixedDictationContent(first, rawText: rawTranscription) {
+            VoxtLog.warning("Remote input dictate cleanup lost mixed-language content; retrying previous prompt once.")
+            do {
+                guard let previousPrompt = instruction(
+                    for: options, rawTranscription: rawTranscription, retryingMixedDictation: true
+                ) else { return rawTranscription }
+                let retried = try await generate(previousPrompt).trimmingCharacters(in: .whitespacesAndNewlines)
+                if !losesMixedDictationContent(retried, rawText: rawTranscription) { return retried }
+            } catch {
+                if error is CancellationError { throw error }
+            }
+            VoxtLog.warning("Remote input dictate cleanup discarded after retry: mixed-language content lost; returning raw transcript.")
+            return rawTranscription
+        }
+        // Same condition as the two-step translate prompt in instruction(for:).
+        if options.mode == .translate, options.customPrompt == nil, appliedSelfCorrections(rawTranscription) == rawTranscription,
+           containsCorrectionCue(rawTranscription) {
+            if let translation = translationAfterCorrection(first) { return translation }
+            VoxtLog.warning("Remote input translate omitted the Translation line; retrying with the one-step prompt.")
+            var oneStep = options
+            oneStep.mode = .translate
+            guard let prompt = instruction(for: oneStep) else { return first }
+            return try await generate(prompt).trimmingCharacters(in: .whitespacesAndNewlines)
+        }
+        if options.mode == .write {
+            let source = [rawTranscription, options.contextBefore, options.contextAfter].joined(separator: "\n")
+            guard containsPlaceholder(first, allowedIn: source) else { return first }
+            VoxtLog.warning("Remote input write output contained a placeholder; retrying once.")
+            guard let retryPrompt = instruction(for: options, rawTranscription: rawTranscription, retryingWritePlaceholder: true) else {
+                throw RemoteInputError(message: "This operation has no compose prompt.")
+            }
+            let retried = try await generate(retryPrompt).trimmingCharacters(in: .whitespacesAndNewlines)
+            guard containsPlaceholder(retried, allowedIn: source) else { return retried }
+            VoxtLog.warning("Remote input write output still contained a placeholder after one retry; nothing inserted.")
+            throw RemoteInputError(message: "Couldn't write that message. Try saying who it's for.")
+        }
+        if options.mode == .dictate { return laidOutMessage(numberedCountedLines(appliedSelfCorrections(first))) }
+        guard options.mode == .edit else { return first }
+        let edited = withoutRepeatedClosing(withoutSurroundingField(first, options: options), options: options)
+        let selection = options.selectedText.trimmingCharacters(in: .whitespacesAndNewlines)
+        let noChangeRequested = ["leave unchanged", "leave this unchanged", "keep it as is", "do not change", "don't change", "no change", "保持原样", "不要改", "不改"]
+            .contains { rawTranscription.localizedCaseInsensitiveContains($0) }
+        func rejected(_ text: String) -> Bool {
+            text.isEmpty || (!noChangeRequested && text == selection)
+                || containsEditInstructionLeakage(text, instruction: rawTranscription, selection: selection)
+                || leaksContext(text, rawTranscription: rawTranscription, options: options)
+        }
+        let droppedFirst = rejected(edited) ? [] : missingDateOrTimeTerms(rawTranscription, selection: selection, output: edited)
+        guard rejected(edited) || !droppedFirst.isEmpty else { return edited }
+        let retry: EditRetry = !droppedFirst.isEmpty ? .droppedTerms(droppedFirst)
+            : !edited.isEmpty && edited == selection ? .unchanged
+            : leaksContext(edited, rawTranscription: rawTranscription, options: options) ? .leaked : .unsafe
+        guard let retryPrompt = instruction(for: options, rawTranscription: rawTranscription, editRetry: retry) else {
+            throw EditNotApplied()
+        }
+        VoxtLog.warning("Remote input edit rejected unchanged output or instruction leakage; retrying once.")
+        do {
+            let retried = withoutRepeatedClosing(withoutSurroundingField(
+                try await generate(retryPrompt).trimmingCharacters(in: .whitespacesAndNewlines), options: options), options: options)
+            guard !rejected(retried),
+                  missingDateOrTimeTerms(rawTranscription, selection: selection, output: retried).isEmpty else { throw EditNotApplied() }
+            return retried
+        } catch {
+            if error is CancellationError { throw error }
+            VoxtLog.warning("Remote input edit not applied after one retry; preserving selection.")
+            throw EditNotApplied()
+        }
+    }
+
+    // MARK: Message layout
+
+    /// Lays out a dictated message that opens with a greeting and has a list, either from the
+    /// model or as three or more points in one sentence ("Hi Karen, X, Y, and Z. Could you…?
+    /// Thanks."): greeting line, paragraphs, numbered points, sign-off line. Only line breaks,
+    /// numbering, capitals, end punctuation and a leading filler change. Qwen3.5-4B kept such
+    /// points in one sentence; asked to number them, it invented intros
+    /// ("Two things:") and dropped a sentence, so the layout is done here.
+    static func laidOutMessage(_ text: String) -> String {
+        let chinese = (hanShare(in: text) ?? 0) >= 0.5
+        var blocks = text.components(separatedBy: "\n\n")
+            .map { $0.trimmingCharacters(in: .whitespacesAndNewlines) }.filter { !$0.isEmpty }
+        guard !blocks.isEmpty, let greeting = splitGreeting(blocks[0], chinese: chinese) else { return text }
+        blocks[0] = greeting.rest
+        var signOff: String?
+        if let last = blocks.last, let split = splitSignOff(last, chinese: chinese) {
+            blocks[blocks.count - 1] = split.rest
+            signOff = split.signOff
+        }
+        blocks = blocks.flatMap { block in numberedPoints(in: block, chinese: chinese) ?? [block] }.filter { !$0.isEmpty }
+        let numbered = try! NSRegularExpression(pattern: #"(?m)^\d+[.)] "#)
+        guard blocks.contains(where: { numbered.firstMatch(in: $0, range: NSRange($0.startIndex..., in: $0)) != nil }) else {
+            return text
+        }
+        if !chinese, let first = blocks.first { blocks[0] = first.prefix(1).uppercased() + first.dropFirst() }
+        return ([greeting.label, greeting.line] + blocks + [signOff]).compactMap { $0 }.joined(separator: "\n\n")
+    }
+
+    /// Numbers a run of two or more lines that starts with "First"/"第一" and continues with
+    /// counting words ("- Second, …", "- 还有，…"), dropping those words and any bullet.
+    static func numberedCountedLines(_ text: String) -> String {
+        let counted = #"^(?:[-*•]\s*)?((?i:first|second|third|fourth|fifth|and also|also|finally|lastly)\b[,:]?\s*|(?:第[一二三四五六七八九十]+|还有|另外|最后)[，,:：、]\s*)"#
+        var lines = text.components(separatedBy: "\n")
+        var index = 0
+        while index < lines.count {
+            var end = index
+            while end < lines.count, lines[end].range(of: counted, options: .regularExpression) != nil { end += 1 }
+            let starts = lines[index].range(of: #"^(?:[-*•]\s*)?(?i:first\b|第一)"#, options: .regularExpression) != nil
+            guard end - index >= 2, starts else { index = max(end, index + 1); continue }
+            for (number, line) in (index..<end).enumerated() {
+                var item = lines[line]
+                item.removeSubrange(item.range(of: counted, options: .regularExpression)!)
+                lines[line] = "\(number + 1). " + item.prefix(1).uppercased() + item.dropFirst()
+            }
+            index = end
+        }
+        return lines.map { countedPointsInline($0) ?? $0 }.joined(separator: "\n")
+    }
+
+    /// "Intro, first, X, second, Y, and also Z. Rest." → intro, numbered X/Y/Z, rest. The first
+    /// marker must be "first"/"第一" at the start of a clause, followed by at least one more marker.
+    private static func countedPointsInline(_ line: String) -> String? {
+        let chinese = (hanShare(in: line) ?? 0) >= 0.5
+        let pattern = chinese
+            ? #"(?:^|(?<=[，。；：,;:]))\s*(第[一二三四五]|还有|另外|最后)[，,、:：]?\s*"#
+            : #"(?:^|(?<=[.;,:!?]\s))(?:and\s+)?((?i:first|second|third|fourth|fifth|also|finally|lastly))\b,?\s+"#
+        let regex = try! NSRegularExpression(pattern: pattern)
+        let matches = regex.matches(in: line, range: NSRange(line.startIndex..., in: line)).compactMap { match in
+            Range(match.range, in: line).flatMap { whole in Range(match.range(at: 1), in: line).map { (whole, line[$0].lowercased()) } }
+        }
+        guard let start = matches.firstIndex(where: { $0.1 == "first" || $0.1 == "第一" }) else { return nil }
+        var markers = [matches[start]]
+        for match in matches[(start + 1)...] where match.1 != "first" && match.1 != "第一" { markers.append(match) }
+        guard markers.count >= 2 else { return nil }
+        let ends: Set<Character> = chinese ? ["。", "！", "？"] : [".", "!", "?"]
+        let lastStart = markers[markers.count - 1].0.upperBound
+        var lastEnd = line.endIndex
+        var cursor = lastStart
+        while cursor < line.endIndex {
+            let next = line.index(after: cursor)
+            if ends.contains(line[cursor]), chinese || next == line.endIndex || line[next] == " " { lastEnd = next; break }
+            cursor = next
+        }
+        let trim = CharacterSet(charactersIn: chinese ? "，,；;。、 " : ",;. ").union(.whitespaces)
+        var items: [String] = []
+        for (position, marker) in markers.enumerated() {
+            let end = position + 1 < markers.count ? markers[position + 1].0.lowerBound : lastEnd
+            var item = String(line[marker.0.upperBound..<end]).trimmingCharacters(in: trim)
+            if !chinese, item.lowercased().hasSuffix(" and") { item = String(item.dropLast(4)).trimmingCharacters(in: trim) }
+            item = item.trimmingCharacters(in: CharacterSet(charactersIn: chinese ? "。！？" : ".!?"))
+            guard !item.isEmpty else { return nil }
+            items.append(chinese ? item + "。" : item.prefix(1).uppercased() + item.dropFirst() + ".")
+        }
+        var intro = String(line[..<markers[0].0.lowerBound]).trimmingCharacters(in: .whitespaces)
+        let rest = String(line[lastEnd...]).trimmingCharacters(in: .whitespaces)
+        let list = items.enumerated().map { "\($0.offset + 1). \($0.element)" }.joined(separator: "\n")
+        var blocks: [String] = []
+        if intro.hasSuffix(",") || intro.hasSuffix("，") || intro.hasSuffix(":") || intro.hasSuffix("：") {
+            intro = String(intro.dropLast()) + (chinese ? "：" : ":")
+            blocks.append(intro + "\n" + list)
+        } else {
+            if !intro.isEmpty { blocks.append(intro) }
+            blocks.append(list)
+        }
+        if !rest.isEmpty { blocks.append(rest) }
+        return blocks.joined(separator: "\n\n")
+    }
+
+    private static func firstMatch(_ pattern: String, in text: String) -> [String?]? {
+        let regex = try! NSRegularExpression(pattern: pattern)
+        guard let match = regex.firstMatch(in: text, range: NSRange(text.startIndex..., in: text)) else { return nil }
+        return (0..<match.numberOfRanges).map { Range(match.range(at: $0), in: text).map { String(text[$0]) } }
+    }
+
+    /// Greeting at the start, after an optional filler or a short label ("Email to my landlord, Hi Karen,").
+    private static func splitGreeting(_ block: String, chinese: Bool) -> (label: String?, line: String, rest: String)? {
+        if chinese {
+            guard let m = firstMatch(#"^(?:(?:嗯|呃|额|那个)[，,]\s*)*((?:[\p{Han}A-Za-z0-9]{1,8}?(?:您好|你好))|大家好|各位好)([，,！!：:])\s*"#, in: block),
+                  let whole = m[0], let name = m[1] else { return nil }
+            return (nil, name + "，", String(block.dropFirst(whole.count)))
+        }
+        let names = #"(?:\s+(?:\p{Lu}[\p{L}'’.-]*|team|all|everyone|everybody|there|guys|folks)){0,3}"#
+        if let m = firstMatch(#"^(?:(?i:um|uh|so|okay|ok)[,.]?\s+)*((?i:hi|hey|hello|dear|good morning|good afternoon|good evening)"# + names + #")\s*[,!:.]\s*"#, in: block),
+           let whole = m[0], let line = m[1] {
+            return (nil, line.prefix(1).uppercased() + line.dropFirst() + ",", String(block.dropFirst(whole.count)))
+        }
+        if let m = firstMatch(#"^((?:[\p{L}'’]+\s+){0,4}[\p{L}'’]+)[,.]\s+((?:Hi|Hey|Hello|Dear)"# + names + #")\s*[,!:]\s*"#, in: block),
+           let whole = m[0], let label = m[1], let line = m[2] {
+            return (label.prefix(1).uppercased() + label.dropFirst() + ".", line + ",", String(block.dropFirst(whole.count)))
+        }
+        return nil
+    }
+
+    /// Sign-off at the very end ("Thanks." / "Thanks, Jo." / "谢谢，小林。").
+    private static func splitSignOff(_ block: String, chinese: Bool) -> (rest: String, signOff: String)? {
+        let pattern = chinese
+            ? #"(?:^|(?<=[。！？!?，,]))\s*(谢谢您|谢谢|多谢|辛苦了|麻烦了)(?:[，,]\s*(\p{Han}{1,4}))?([。！!]?)\s*$"#
+            : #"(?:^|(?<=[.!?]))\s*((?i:thanks so much|thanks a lot|thank you|many thanks|thanks|cheers|best regards|regards|all the best|best))(?:,?\s+(\p{Lu}[\p{L}'’-]*))?([.!]?)\s*$"#
+        guard let m = firstMatch(pattern, in: block), let whole = m[0], let word = m[1] else { return nil }
+        var rest = String(block.dropLast(whole.count)).trimmingCharacters(in: .whitespaces)
+        if chinese, rest.hasSuffix("，") || rest.hasSuffix(",") { rest = String(rest.dropLast()) + "。" }
+        let signOff = m[2].map { word + (chinese ? "，" : ",") + "\n" + $0 } ?? word + (m[3] ?? "")
+        return (rest, signOff)
+    }
+
+    /// Splits a one-line paragraph around its first sentence of three or more comma-separated
+    /// points that ends with "…, and Z" (还有/另外/以及 Z): [before, numbered points, after].
+    private static func numberedPoints(in block: String, chinese: Bool) -> [String]? {
+        guard !block.contains("\n") else { return nil }
+        let sentences = sentences(in: block)
+        for (position, sentence) in sentences.enumerated() {
+            guard let (lead, points) = points(in: sentence, chinese: chinese) else { continue }
+            let items = points.enumerated().map { "\($0.offset + 1). \($0.element)" }.joined(separator: "\n")
+            let separator = chinese ? "" : " "
+            let before = Array(sentences[..<position]) + [lead].compactMap { $0 }
+            return [before.joined(separator: separator), items, sentences[(position + 1)...].joined(separator: separator)]
+        }
+        return nil
+    }
+
+    static let targetLanguageTemplateVariable = "{{TARGET_LANGUAGE}}"
+
+    private static func translateTask(target: String) -> String {
+        """
+        Translate the transcribed speech into \(target).
+        The transcript may contain fillers, repetitions and self-corrections:
+        do not carry them into the translation, but preserve meaning, names, and numbers.
+        Apply self-corrections before translating. When the speaker says a detail and then replaces it, even after a pause,
+        an ellipsis or a full stop (Thursday... actually, Friday; three, sorry, four; 周一，不对，周二),
+        keep only the corrected detail: the translation contains only the replacement.
+        Never mention, translate or explain the earlier value.
+        Translate only what was said: add no places, rooms, times, reasons or other details, and keep every name, number and date.
+        Output only the translation, without explanations or the original text.
+        """
+    }
