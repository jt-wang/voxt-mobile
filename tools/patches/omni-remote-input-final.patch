             rawTranscription: text,
-            glossarySelectionPolicy: provisionalStrategy.glossarySelectionPolicy
+            glossarySelectionPolicy: provisionalStrategy.glossarySelectionPolicy,
+            usesAppBranch: usesAppBranch,
