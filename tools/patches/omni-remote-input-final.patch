diff --git a/Voxt/Voxt/Settings/RemoteInputSettingsCard.swift b/Voxt/Voxt/Settings/RemoteInputSettingsCard.swift
new file mode 100644
index 0000000..80b3ae8
--- /dev/null
+++ b/Voxt/Voxt/Settings/RemoteInputSettingsCard.swift
@@ -0,0 +1,171 @@
+// RemoteInputSettingsCard.swift
+// Provides the General settings card for Remote Input (dictation from Voxt Mobile).
+
+import AppKit
+import CoreImage.CIFilterBuiltins
+import SwiftUI
+
+private func localized(_ key: String) -> String {
+    AppLocalization.localizedString(key)
+}
+
+private func localizedKey(_ key: String) -> LocalizedStringKey {
+    LocalizedStringKey(localized(key))
+}
+
+struct RemoteInputSettingsCard: View {
+    @AppStorage(AppPreferenceKey.remoteInputServerEnabled) private var isEnabled = false
+    @AppStorage(AppPreferenceKey.historySyncEnabled) private var historySyncEnabled = false
+    @AppStorage(AppPreferenceKey.remoteInputServerPort) private var port = RemoteInputSettings.defaultPort
+    @AppStorage(AppPreferenceKey.remoteInputPublicAddress) private var publicAddress = ""
+    @State private var portText = ""
+    @State private var token = ""
+    @State private var status: RemoteInputServerStatus = .off
+
+    var body: some View {
+        GeneralSettingsCard(title: localizedKey("Remote Input")) {
+            GeneralToggleRow(
+                title: localizedKey("Allow dictation from Voxt Mobile"),
+                description: localizedKey("Your phone records, this Mac transcribes with your current model and enhancement settings, and the text goes back to the phone."),
+                isOn: $isEnabled
+            )
+            GeneralToggleRow(
+                title: localizedKey("Sync history with Voxt Mobile"),
+                description: localizedKey("Paired phones exchange text history when this and History are both on. Audio and meeting transcripts stay on this Mac."),
+                isOn: $historySyncEnabled
+            )
+
+            if isEnabled {
+                Text(statusText)
+                    .font(.caption)
+                    .foregroundStyle(statusIsError ? .red : .secondary)
+
+                GeneralFieldRow(
+                    title: localizedKey("Port"),
+                    description: localizedKey("Voxt listens on 127.0.0.1 only.")
+                ) {
+                    TextField(String(RemoteInputSettings.defaultPort), text: $portText)
+                        .textFieldStyle(.plain)
+                        .settingsFieldSurface(width: 90)
+                        .onSubmit(applyPort)
+                }
+
+                GeneralFieldRow(
+                    title: localizedKey("Reach this Mac from your phone"),
+                    description: localizedKey("Run this once in Terminal. Tailscale publishes the port to your tailnet over HTTPS.")
+                ) {
+                    Text(RemoteInputSettings.tailscaleServeCommand(port: port))
+                        .font(.system(.caption, design: .monospaced))
+                        .textSelection(.enabled)
+                    Button(localized("Copy")) { copy(RemoteInputSettings.tailscaleServeCommand(port: port)) }
+                        .buttonStyle(SettingsPillButtonStyle(horizontalPadding: 10, height: 28))
+                }
+
+                GeneralFieldRow(
+                    title: localizedKey("Mac address"),
+                    description: localizedKey("The HTTPS name `tailscale serve` prints, including the port.")
+                ) {
+                    TextField("your-mac.tailnet.ts.net:\(RemoteInputSettings.publicPort(forLocalPort: port))", text: $publicAddress)
+                        .textFieldStyle(.plain)
+                        .settingsFieldSurface(width: 260)
+                }
+
+                GeneralFieldRow(
+                    title: localizedKey("Access token"),
+                    description: localizedKey("The phone sends this with every request. Regenerating it unpairs existing phones.")
+                ) {
+                    Text(maskedToken)
+                        .font(.system(.caption, design: .monospaced))
+                    Button(localized("Copy")) { copy(token) }
+                        .buttonStyle(SettingsPillButtonStyle(horizontalPadding: 10, height: 28))
+                    Button(localized("Regenerate")) {
+                        token = RemoteInputSettings.regenerateToken()
+                        notifySettingsChanged()
+                    }
+                    .buttonStyle(SettingsPillButtonStyle(horizontalPadding: 10, height: 28))
+                }
+
+                if let link = pairingLink, let image = Self.qrImage(for: link.absoluteString) {
+                    HStack(alignment: .center, spacing: 16) {
+                        Image(nsImage: image)
+                            .interpolation(.none)
+                            .resizable()
+                            .frame(width: 140, height: 140)
+                            .accessibilityLabel(Text(localizedKey("Pairing QR code")))
+                        Text(localizedKey("Scan with the iPhone camera to pair Voxt Mobile."))
+                            .font(.caption)
+                            .foregroundStyle(.secondary)
+                    }
+                }
+            }
+        }
+        .onAppear {
+            portText = String(port)
+            token = RemoteInputSettings.token()
+            refreshStatus()
+        }
+        .onChange(of: isEnabled) { _, _ in notifySettingsChanged() }
+        .onReceive(NotificationCenter.default.publisher(for: .voxtRemoteInputStatusDidChange)) { _ in
+            refreshStatus()
+        }
+    }
+
+    private var pairingLink: URL? {
+        let address = publicAddress.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !address.isEmpty, !token.isEmpty else { return nil }
+        let baseURL = address.contains("://") ? address : "https://\(address)"
+        return RemoteInputSettings.pairingLink(baseURL: baseURL, token: token)
+    }
+
+    private var maskedToken: String {
+        guard token.count > 8 else { return token }
+        return "\(token.prefix(4))…\(token.suffix(4))"
+    }
+
+    private var statusText: String {
+        switch status {
+        case .off: localized("Stopped")
+        case .starting: localized("Starting…")
+        case let .listening(port): String(format: localized("Listening on 127.0.0.1:%d"), port)
+        case let .failed(reason): String(format: localized("Couldn't start: %@"), reason)
+        }
+    }
+
+    private var statusIsError: Bool {
+        if case .failed = status { return true }
+        return false
+    }
+
+    private func applyPort() {
+        guard let value = Int(portText.trimmingCharacters(in: .whitespaces)), (1024...65534).contains(value) else {
+            portText = String(port)
+            return
+        }
+        port = value
+        notifySettingsChanged()
+    }
+
+    private func refreshStatus() {
+        status = AppDelegate.shared?.remoteInputServerStatus ?? .off
+    }
+
+    private func notifySettingsChanged() {
+        NotificationCenter.default.post(name: .voxtRemoteInputSettingsDidChange, object: nil)
+    }
+
+    private func copy(_ text: String) {
+        NSPasteboard.general.clearContents()
+        NSPasteboard.general.setString(text, forType: .string)
+    }
+
+    static func qrImage(for text: String) -> NSImage? {
+        let filter = CIFilter.qrCodeGenerator()
+        filter.message = Data(text.utf8)
+        filter.correctionLevel = "M"
+        guard let output = filter.outputImage?.transformed(by: CGAffineTransform(scaleX: 8, y: 8)) else { return nil }
+        let representation = NSCIImageRep(ciImage: output)
+        let image = NSImage(size: representation.size)
+        image.addRepresentation(representation)
+        return image
+    }
+}
diff --git a/Voxt/Voxt/Settings/Shell/AppPreferenceKey.swift b/Voxt/Voxt/Settings/Shell/AppPreferenceKey.swift
