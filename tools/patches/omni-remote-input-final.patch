+// RemoteInputRequestHandlerTests.swift
+// Provides Remote Input request handler tests for Voxt test coverage.
+
+import XCTest
+@testable import Voxt
+
+final class RemoteInputRequestHandlerTests: XCTestCase {
+    func testLocalOnlyRequestRejectsCloudBeforePipelineEvenAfterPreflight() async throws {
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 100), version: "1",
+            dictate: { _ in XCTFail("Cloud pipeline reached"); return .error(status: 500, "unused") },
+            compose: { _ in XCTFail("Cloud pipeline reached"); return .error(status: 500, "unused") },
+            capabilities: { .resolve(transcriptionEngine: "remote", enhancementMode: "customLLM") })
+        var audio = request("POST", "/v1/dictations")
+        audio.headers["content-type"] = "audio/wav"
+        audio.headers["x-voxt-model-policy"] = "local-only"
+        audio.body = Data([1])
+        let response = await handler(audio)
+        XCTAssertEqual(response.status, 403)
+    }
+
+    func testModelLocalityIsConservativeAndMatchesSelectedProviders() {
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "mlxAudio", enhancementMode: "customLLM").transcription, "local")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "mlxAudio", enhancementMode: "customLLM").text, "local")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "remote", enhancementMode: "remoteLLM").transcription, "remote")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "remote", enhancementMode: "remoteLLM").text, "remote")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "dictation", enhancementMode: "appleIntelligence").transcription, "unknown")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "dictation", enhancementMode: "appleIntelligence", appleSpeechOnDevice: true).transcription, "local")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "mlxAudio", enhancementMode: "appleIntelligence").text, "local")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "future", enhancementMode: "future").text, "unknown")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "future", enhancementMode: "off").transcription, "unknown")
+        XCTAssertEqual(RemoteInputCapabilities.resolve(transcriptionEngine: "mlxAudio", enhancementMode: "off").text, "local")
+    }
+
+    func testCapabilitiesRequireAuthenticationAndReadCurrentSelection() async throws {
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 10), version: "1",
+            dictate: { _ in .error(status: 500, "unused") },
+            compose: { _ in .error(status: 500, "unused") },
+            capabilities: { .resolve(transcriptionEngine: "mlxAudio", enhancementMode: "remoteLLM") })
+        let forbidden = await handler(request("GET", "/v1/capabilities", token: "wrong"))
+        XCTAssertEqual(forbidden.status, 401)
+        let response = await handler(request("GET", "/v1/capabilities"))
+        XCTAssertEqual(response.status, 200)
+        let body = try JSONDecoder().decode(RemoteInputCapabilities.self, from: response.body)
+        XCTAssertEqual(body.transcription, "local")
+        XCTAssertEqual(body.text, "remote")
+    }
+
+    func testBuiltInPromptsRequirePairingAndListEveryMode() async throws {
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 10), version: "1",
+            dictate: { _ in .error(status: 500, "unused") },
+            compose: { _ in .error(status: 500, "unused") })
+        let forbidden = await handler(request("GET", "/v1/compose/prompts", token: "wrong"))
+        XCTAssertEqual(forbidden.status, 401)
+        let wrongMethod = await handler(request("POST", "/v1/compose/prompts"))
+        XCTAssertEqual(wrongMethod.status, 405)
+        let response = await handler(request("GET", "/v1/compose/prompts"))
+        XCTAssertEqual(response.status, 200)
+        let body = try JSONDecoder().decode([String: [String: String]].self, from: response.body)
+        XCTAssertEqual(body["prompts"], RemoteInputComposePrompt.builtInPrompts())
+    }
+
+    private func request(_ method: String, _ path: String, token: String = "t") -> RemoteInputHTTPRequest {
+        RemoteInputHTTPRequest(method: method, path: path, headers: ["authorization": "Bearer \(token)"])
+    }
+
+    func testHealthAnswersWhileMainActorIsBusy() async throws {
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 10),
+            version: "9.9",
+            dictate: { @MainActor _ in .json(status: 200, ["text": "x"]) },
+            compose: { @MainActor _ in .json(status: 200, ["text": "x"]) }
+        )
+        let mainBusy = Task { @MainActor in Thread.sleep(forTimeInterval: 1.5) }
+        try await Task.sleep(for: .milliseconds(100))
+
+        let started = Date()
+        let response = await Task.detached { await handler(self.request("GET", "/v1/health")) }.value
+        let elapsed = Date().timeIntervalSince(started)
+        await mainBusy.value
+
+        XCTAssertEqual(response.status, 200)
+        XCTAssertLessThan(elapsed, 0.5, "health waited for the main actor")
+        let body = try XCTUnwrap(JSONSerialization.jsonObject(with: response.body) as? [String: Any])
+        XCTAssertEqual(body["ok"] as? Bool, true)
+        XCTAssertEqual(body["version"] as? String, "9.9")
+    }
+
+    func testRejectionsDoNotReachDictation() async {
+        let dictated = expectation(description: "dictate")
+        dictated.isInverted = true
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 10),
+            version: "1",
+            dictate: { @MainActor _ in
+                dictated.fulfill()
+                return .json(status: 200, ["text": "x"])
+            },
+            compose: { @MainActor _ in .json(status: 200, ["text": "x"]) }
+        )
+        let response = await handler(request("POST", "/v1/dictations", token: "wrong"))
+        XCTAssertEqual(response.status, 401)
+        await fulfillment(of: [dictated], timeout: 0.2)
+    }
+
+    func testDictationIsForwarded() async throws {
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 10),
+            version: "1",
+            dictate: { @MainActor request in .json(status: 200, ["ext": request.fileExtension]) },
+            compose: { @MainActor request in .json(status: 200, ["ext": request.fileExtension]) }
+        )
+        var dictation = request("POST", "/v1/dictations")
+        dictation.headers["content-type"] = "audio/wav"
+        dictation.body = Data([1])
+        let response = await handler(dictation)
+        let body = try XCTUnwrap(JSONSerialization.jsonObject(with: response.body) as? [String: String])
+        XCTAssertEqual(body["ext"], "wav")
+    }
+
+    func testComposeIsForwarded() async throws {
+        let handler = RemoteInputRequestHandler.make(
+            router: RemoteInputRouter(token: "t", maxBodyBytes: 1_000),
+            version: "1",
+            dictate: { @MainActor _ in .json(status: 200, ["text": "x"]) },
+            compose: { @MainActor request in .json(status: 200, ["mode": request.options.mode.rawValue]) }
+        )
+        var compose = request("POST", "/v1/compose")
+        compose.headers["content-type"] = "application/json"
+        compose.body = try JSONSerialization.data(withJSONObject: [
+            "audio": Data([1]).base64EncodedString(),
+            "contentType": "audio/wav",
+            "options": ["mode": "write", "style": "concise", "vocabulary": [], "selectedText": "", "contextBefore": "", "contextAfter": "", "targetLanguage": NSNull()]
+        ])
+        let response = await handler(compose)
+        let body = try XCTUnwrap(JSONSerialization.jsonObject(with: response.body) as? [String: String])
+        XCTAssertEqual(body["mode"], "write")
+    }
+}
