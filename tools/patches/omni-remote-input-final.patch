@@ -0,0 +1,36 @@
+// RemoteInputTokenStoreTests.swift
+// The Remote Input token must outlive a restart: the Connector and paired phones hold it.
+
+import XCTest
+@testable import Voxt
+
+final class RemoteInputTokenStoreTests: XCTestCase {
+    /// Stands in for the login Keychain: items by service and account, shared across store instances.
+    private final class FakeKeychain: RemoteInputTokenStore.Keychain, @unchecked Sendable {
+        var items: [String: String] = [:]
+        func read(service: String, account: String) throws -> String? { items[service + "/" + account] }
+        func write(_ value: String, service: String, account: String) throws { items[service + "/" + account] = value }
+        func delete(service: String, account: String) throws { items[service + "/" + account] = nil }
+    }
+
+    func testATokenSavedBeforeARestartIsReadAfterIt() throws {
+        let keychain = FakeKeychain()
+        try RemoteInputTokenStore(service: "com.example.remote-input", keychain: keychain).write("token-1", account: "remoteInputServerToken")
+        let afterRestart = RemoteInputTokenStore(service: "com.example.remote-input", keychain: keychain)
+        XCTAssertEqual(try afterRestart.read(account: "remoteInputServerToken"), "token-1")
+        let otherService = RemoteInputTokenStore(service: "com.example.other", keychain: keychain)
+        XCTAssertNil(try otherService.read(account: "remoteInputServerToken"))
+    }
+
+    // The service and account predate the rename from RemoteInputDevKeychain; changing either would orphan the
+    // token a running Voxt Omni Dev saved, and every paired Connector and phone would need pairing again.
+    func testTheLiveServiceAndAccountAreUnchanged() {
+        XCTAssertEqual(RemoteInputTokenStore.liveService, "com.voxt.Voxt.omni.dev.remote-input")
+        XCTAssertEqual(RemoteInputSettings.tokenAccount, "remoteInputServerToken")
+    }
+
+    // The full suite stalls in SecItemCopyMatching on the real login Keychain.
+    func testTestsNeverReachTheLoginKeychain() {
+        XCTAssertNil(RemoteInputTokenStore.forCurrentProcess)
+    }
+}
