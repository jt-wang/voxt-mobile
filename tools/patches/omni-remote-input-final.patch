+// RemoteInputComposePromptTests.swift
+// Provides Remote Input compose prompt-building tests for Voxt test coverage.
+
+import XCTest
+@testable import Voxt
+
+final class RemoteInputComposePromptTests: XCTestCase {
+    func testMixedDictationRetriesPreviousPromptAndPreservesBothLanguages() async throws {
+        let raw = "Tomorrow at three 开会，please bring the draft."
+        var prompts: [String] = []
+        let result = try await RemoteInputComposePrompt.compose(rawTranscription: raw, options: options(.dictate)) { prompt in
+            prompts.append(prompt)
+            return prompts.count == 1 ? "Tomorrow at three, please bring the draft." : raw
+        }
+        XCTAssertEqual(result, raw)
+        XCTAssertEqual(prompts.count, 2)
+        XCTAssertNotEqual(prompts.first, prompts.last)
+        XCTAssertTrue(prompts.last?.contains("Remove fillers, repetitions and self-corrections") == true)
+    }
+
+    func testMixedDictationFallsBackAfterOneFailedRetry() async throws {
+        let raw = "明天下午三点开会，记得带上 laptop 和充电器。"
+        var calls = 0
+        let result = try await RemoteInputComposePrompt.compose(rawTranscription: raw, options: options(.dictate)) { _ in
+            calls += 1
+            return "明天下午三点开会，记得带上电脑和充电器。"
+        }
+        XCTAssertEqual(result, raw)
+        XCTAssertEqual(calls, 2)
+    }
+
+    func testMixedDictationRetryErrorFallsBackToRawText() async throws {
+        let raw = "Please bring 文件 and the laptop."
+        var calls = 0
+        let result = try await RemoteInputComposePrompt.compose(rawTranscription: raw, options: options(.dictate)) { _ in
+            calls += 1
+            if calls == 2 { throw RemoteInputError(message: "test failure") }
+            return "Please bring documents and the laptop."
+        }
+        XCTAssertEqual(result, raw)
+        XCTAssertEqual(calls, 2)
+    }
+
+    func testMixedDictationDoesNotRetryPreservedScriptsOrPureLanguages() async throws {
+        for (raw, output) in [
+            ("Um, please bring 文件 and the laptop.", "Please bring 文件 and the laptop."),
+            ("Um, bring the laptop.", "Bring the laptop."),
+            ("嗯，带上电脑。", "带上电脑。"),
+            ("Use variable x for 中文内容。", "Use variable x for 中文内容。")
+        ] {
+            var calls = 0
+            let result = try await RemoteInputComposePrompt.compose(rawTranscription: raw, options: options(.dictate)) { _ in
+                calls += 1
+                return output
+            }
+            XCTAssertEqual(result, output)
+            XCTAssertEqual(calls, 1)
+        }
+    }
+
+    func testMixedDictationLossThresholdAndSmallScriptControls() {
+        let raw = "一二三四五六七八九十 one two three four five six seven eight nine ten"
+        XCTAssertTrue(RemoteInputComposePrompt.losesMixedDictationContent("一二 one two three", rawText: raw))
+        XCTAssertTrue(RemoteInputComposePrompt.losesMixedDictationContent("一二三 one two", rawText: raw))
+        XCTAssertFalse(RemoteInputComposePrompt.losesMixedDictationContent("一二三 one two three", rawText: raw))
+        XCTAssertFalse(RemoteInputComposePrompt.losesMixedDictationContent("English only", rawText: "English only"))
+        XCTAssertFalse(RemoteInputComposePrompt.losesMixedDictationContent("纯中文", rawText: "纯中文内容"))
+        XCTAssertFalse(RemoteInputComposePrompt.losesMixedDictationContent("中文内容", rawText: "中文内容 x"))
+        XCTAssertFalse(RemoteInputComposePrompt.losesMixedDictationContent("a name", rawText: "李 a name"))
+    }
+
+    func testMixedDictationCancellationDoesNotReturnFallback() async throws {
