diff --git a/Voxt/Mobile/docs/evidence/connector-link-sandbox/client.swift b/Voxt/Mobile/docs/evidence/connector-link-sandbox/client.swift
new file mode 100644
index 0000000000000000000000000000000000000000..9f3566644936119d4476dd2501af65b8c071a0ad
--- /dev/null
+++ b/Voxt/Mobile/docs/evidence/connector-link-sandbox/client.swift
@@ -0,0 +1,16 @@
+// Runs Voxt Connector's real ConnectorLink once and prints Voxt's answer.
+import Foundation
+setbuf(stdout, nil)
+print("client team: \(PeerSignature.ownTeamIdentifier() ?? "none")")
+print("client candidates: \(ConnectorLink.socketPaths())")
+let done = DispatchSemaphore(value: 0)
+Task {
+    do {
+        let grant = try await ConnectorLink(replyTimeout: 10).authorize()
+        print("client approved port=\(grant.port) token=\(grant.token) alwaysAllowed=\(grant.alwaysAllowed)")
+    } catch {
+        print("client failed: \(error)")
+    }
+    done.signal()
+}
+done.wait()
diff --git a/Voxt/Mobile/docs/evidence/connector-link-sandbox/run-applications.sh b/Voxt/Mobile/docs/evidence/connector-link-sandbox/run-applications.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2f7b2ec56e9f0ee50a4b923ed57dad27c318e460
--- /dev/null
+++ b/Voxt/Mobile/docs/evidence/connector-link-sandbox/run-applications.sh
@@ -0,0 +1,20 @@
+#!/bin/bash
+# One run: the sandboxed link server, the signed client bundle in /Applications (accepted), the same
+# bundle with a broken seal (rejected), and the client outside /Applications (rejected). The bundle
+# in /Applications exists only while this script runs.
+set -u
+APP="/Applications/Voxt LinkCheck.app"
+SP=""
+cleanup() { [ -n "$SP" ] && kill "$SP" 2>/dev/null; rm -rf "$APP"; }
+trap cleanup EXIT
+[ -e "$APP" ] && { echo "refusing: $APP already exists"; exit 1; }
+./LinkServer.app/Contents/MacOS/LinkServer > server.log 2>&1 & SP=$!
+sleep 2
+ditto "LinkCheck-stage/Voxt LinkCheck.app" "$APP"
+echo "== client in /Applications, signed"
+perl -e 'alarm 15; exec { $ARGV[0] } @ARGV' "$APP/Contents/MacOS/linkclient" 2>&1; echo "exit=$?"
+echo "== same bundle, seal broken by an added resource"
+mkdir -p "$APP/Contents/Resources" && echo x > "$APP/Contents/Resources/added.txt"
+perl -e 'alarm 15; exec { $ARGV[0] } @ARGV' "$APP/Contents/MacOS/linkclient" 2>&1; echo "exit=$?"
+echo "== client outside /Applications"
+perl -e 'alarm 15; exec { $ARGV[0] } @ARGV' ./linkclient 2>&1; echo "exit=$?"
diff --git a/Voxt/Mobile/docs/evidence/connector-link-sandbox/run-broken-fresh.sh b/Voxt/Mobile/docs/evidence/connector-link-sandbox/run-broken-fresh.sh
