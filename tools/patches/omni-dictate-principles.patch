+        XCTAssertEqual(RemoteInputComposePrompt.joinedSpelledAcronyms("这个 A P I 太慢了"), "这个 API 太慢了")
+        XCTAssertEqual(RemoteInputComposePrompt.joinedSpelledAcronyms("用 A I 写的"), "用 AI 写的")
+        XCTAssertEqual(RemoteInputComposePrompt.joinedSpelledAcronyms("APIの I O が遅い"), "APIの I/O が遅い")
+        for unchanged in ["Plan A I think works.", "I went to A B C Mart.", "这个 API 太慢了", "用 Q 键"] {
