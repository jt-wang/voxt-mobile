+        let maxRevision: Int = last["revision"]
+        let hasMore = try Int.fetchOne(
+            db,
+            sql: "SELECT 1 FROM history_sync_changes WHERE revision > ? LIMIT 1",
+            arguments: [maxRevision]
+        ) != nil
+        var items: [HistorySyncItem] = []
+        var deletedIDs: [UUID] = []
+        for row in rows {
