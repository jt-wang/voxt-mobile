// Signing for a device build. Simulator builds need none of this.
// Don't edit here: run `ios/tools/set-team.sh`, which writes Signing.local.xcconfig (not committed).
DEVELOPMENT_TEAM =
// The app's bundle ID; the keyboard is PREFIX.keyboard and the App Group group.PREFIX.shared.
// These IDs are registered to the official build's team, and bundle and App Group IDs are
// unique across all Apple teams, so every other signer needs their own prefix (set-team.sh).
VOXT_MOBILE_ID_PREFIX = io.jingtao.voxtmobile
#include? "Signing.local.xcconfig"
VOXT_APP_GROUP = group.$(VOXT_MOBILE_ID_PREFIX).shared
